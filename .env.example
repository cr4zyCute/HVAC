# NorthStar HVAC Environment Configuration

# Database Configuration (Defaults to local SQLite 'file:northstar.db' for development)
# For production Turso / LibSQL deployment:
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# Initial seed password for the owner account (admin@northstarhvac.com)
ADMIN_INITIAL_PASSWORD=NorthStarAdmin2026!

# Cryptographic salt secret for Anti-CSRF token verification
CSRF_SECRET=northstar-hvac-csrf-secret-salt-2026

# Node environment (production enforces Secure HTTPS-only cookies)
NODE_ENV=development

