---
import Layout from '@/layouts/Layout.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import CTABanner from '@/components/sections/CTABanner.astro';

const regions = [
  {
    name: "Central Metro & Downtown",
    dispatchTime: "30–45 Mins",
    activeVans: 3,
    zipCodes: "97201, 97204, 97205, 97209, 97214",
    neighborhoods: ["Downtown Core", "Pearl District", "South Waterfront", "Old Town", "Central Eastside"],
    status: "Active Dispatch"
  },
  {
    name: "West Valley & Hills",
    dispatchTime: "40–55 Mins",
    activeVans: 2,
    zipCodes: "97221, 97223, 97225, 97229, 97005",
    neighborhoods: ["West Slope", "Beaverton Hills", "Cedar Mill", "Raleigh Hills", "Garden Home"],
    status: "Active Dispatch"
  },
  {
    name: "North Suburbs & River District",
    dispatchTime: "35–50 Mins",
    activeVans: 2,
    zipCodes: "97217, 97203, 97211, 97212, 97218",
    neighborhoods: ["St. Johns", "Kenton", "Alberta Arts", "Overlook", "Concordia"],
    status: "Active Dispatch"
  },
  {
    name: "Eastside & Parkside",
    dispatchTime: "40–50 Mins",
    activeVans: 2,
    zipCodes: "97213, 97215, 97216, 97230, 97233",
    neighborhoods: ["Hawthorne", "Mount Tabor", "Hollywood", "Montavilla", "Parkrose"],
    status: "Active Dispatch"
  },
  {
    name: "South County & Lake District",
    dispatchTime: "45–60 Mins",
    activeVans: 1,
    zipCodes: "97034, 97035, 97036, 97219, 97239",
    neighborhoods: ["Lake Oswego", "West Linn", "South Burlingame", "Multnomah Village", "Riverdale"],
    status: "Active Dispatch"
  },
  {
    name: "Northwest Heights & Forest Park",
    dispatchTime: "45–60 Mins",
    activeVans: 1,
    zipCodes: "97210, 97229, 97231",
    neighborhoods: ["Forest Park", "Skyline", "Nob Hill", "Alphabet District", "Linnton"],
    status: "Active Dispatch"
  }
];
---

<Layout 
  title="HVAC Service Areas & Coverage — NorthStar HVAC" 
  description="Discover NorthStar HVAC's service coverage areas. Fast 45-minute average emergency dispatch across central metro, west valley, north suburbs, and eastside."
>
  <!-- Hero Section -->
  <section class="bg-neutral-bg border-b border-neutral-border py-64 md:py-80">
    <div class="container">
      <div class="max-w-3xl space-y-16">
        <Badge variant="info">RAPID REGIONAL DISPATCH</Badge>
        <h1 class="text-h1 font-heading font-extrabold text-brand-primary leading-tight">
          Reliable Heating &amp; Cooling Across the Entire Metro Area
        </h1>
        <p class="text-body text-text-secondary leading-relaxed">
          With mobile service technicians strategically stationed throughout six key regional hubs, we provide prompt, reliable diagnostic arrivals and rapid 24/7 emergency response.
        </p>

        <!-- ZIP Search Tool Box -->
        <div class="bg-neutral-surface p-24 rounded-lg border border-neutral-border shadow-sm max-w-xl space-y-12 mt-24">
          <label for="zip-input" class="block text-small font-heading font-bold text-brand-primary">
            Check If Your Neighborhood Is Covered:
          </label>
          <div class="flex flex-col sm:flex-row gap-12">
            <input 
              type="text" 
              id="zip-input" 
              placeholder="Enter your 5-digit ZIP (e.g. 97201)" 
              maxlength="5"
              class="flex-1 px-16 py-12 border border-neutral-border rounded-md text-small focus:border-brand-primary focus:ring-1 focus:ring-brand-primary outline-none"
            />
            <button 
              id="check-zip-btn" 
              type="button"
              class="px-24 py-12 bg-brand-primary text-white font-bold rounded-md hover:bg-brand-secondary transition-colors text-small flex items-center justify-center gap-8"
            >
              <Icon name="search" size={16} />
              <span>Check Coverage</span>
            </button>
          </div>
          <div id="zip-result" class="hidden text-small p-12 rounded-md font-medium"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Regions Grid -->
  <section class="py-80 bg-neutral-surface">
    <div class="container space-y-48">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-16 border-b border-neutral-border pb-24">
        <div>
          <span class="text-caption font-bold tracking-wider text-brand-accent uppercase">Our Coverage Hubs</span>
          <h2 class="text-h2 font-heading font-bold text-brand-primary mt-8">
            Regional Response Centers
          </h2>
        </div>
        <p class="text-small text-text-muted max-w-md">
          Every region is supported by fully stocked service vans ready for same-day repair calls.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-32">
        {regions.map((region) => (
          <div class="bg-neutral-bg p-32 rounded-lg border border-neutral-border space-y-20 flex flex-col justify-between hover:border-brand-primary transition-colors">
            <div class="space-y-16">
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-6 text-[12px] font-bold text-emerald-700 bg-emerald-50 px-8 py-4 rounded-sm border border-emerald-200">
                  <span class="w-6 h-6 rounded-full bg-emerald-600 animate-pulse"></span>
                  {region.status}
                </span>
                <span class="text-caption font-semibold text-text-muted">
                  {region.activeVans} Vans On Duty
                </span>
              </div>

              <div>
                <h3 class="text-h3 font-heading font-bold text-brand-primary">{region.name}</h3>
                <div class="text-caption text-brand-accent font-semibold mt-4">
                  Avg. Dispatch: {region.dispatchTime}
                </div>
              </div>

              <div class="space-y-6 pt-12 border-t border-neutral-border">
                <span class="text-[12px] font-bold text-brand-primary uppercase tracking-wider block">Neighborhoods Served:</span>
                <p class="text-small text-text-secondary">
                  {region.neighborhoods.join(", ")}
                </p>
              </div>

              <div class="text-caption text-text-muted">
                <strong>ZIP Codes:</strong> {region.zipCodes}
              </div>
            </div>

            <div class="pt-16 border-t border-neutral-border">
              <Button href="/book" variant="primary" size="sm" class="w-full">
                Schedule Service Here
                <Icon name="arrow-right" size={14} />
              </Button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Punctuality & Response Time Guarantee -->
  <section class="py-80 bg-neutral-bg border-y border-neutral-border">
    <div class="container space-y-48">
      <div class="text-center max-w-2xl mx-auto space-y-12">
        <Badge variant="neutral">ARRIVAL GUARANTEE</Badge>
        <h2 class="text-h2 font-heading font-bold text-brand-primary">
          We Respect Your Valuable Time
        </h2>
        <p class="text-body text-text-secondary">
          No waiting around all day wondering when someone will show up. We hold ourselves to strict punctuality standards.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-32">
        <div class="bg-neutral-surface p-32 rounded-lg border border-neutral-border space-y-12 text-center shadow-sm">
          <div class="w-56 h-56 rounded-full bg-blue-50 text-brand-primary flex items-center justify-center mx-auto">
            <Icon name="clock" size={28} />
          </div>
          <h3 class="text-h3 font-heading font-bold text-brand-primary">2-Hour Arrival Windows</h3>
          <p class="text-small text-text-secondary leading-relaxed">
            Choose a morning, afternoon, or evening window that fits your schedule. We never ask you to sit through vague 8-hour blocks.
          </p>
        </div>

        <div class="bg-neutral-surface p-32 rounded-lg border border-neutral-border space-y-12 text-center shadow-sm">
          <div class="w-56 h-56 rounded-full bg-amber-50 text-brand-accent flex items-center justify-center mx-auto">
            <Icon name="phone" size={28} />
          </div>
          <h3 class="text-h3 font-heading font-bold text-brand-primary">20-Minute Call Ahead</h3>
          <p class="text-small text-text-secondary leading-relaxed">
            Your technician calls or sends a live GPS tracking link when they are en route, giving you ample time to prepare.
          </p>
        </div>

        <div class="bg-neutral-surface p-32 rounded-lg border border-neutral-border space-y-12 text-center shadow-sm">
          <div class="w-56 h-56 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto">
            <Icon name="shield" size={28} />
          </div>
          <h3 class="text-h3 font-heading font-bold text-brand-primary">Emergency Rush Guarantee</h3>
          <p class="text-small text-text-secondary leading-relaxed">
            During sub-freezing winter storms or extreme summer heatwaves, our priority emergency trucks reach critical situations in under an hour.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <CTABanner
    title="Ready to Book Fast HVAC Service in Your Area?"
    subtitle="Find out why homeowners across the metro trust NorthStar for all heating and cooling repairs."
    primaryCta={{ label: "Schedule Now", href: "/book" }}
    secondaryCta={{ label: "24/7 Emergency Call", href: "/emergency" }}
    variant="primary"
  />

  <!-- Interactive ZIP Checker Script -->
  <script is:inline>
    const coveredZips = [
      "97201", "97204", "97205", "97209", "97214",
      "97221", "97223", "97225", "97229", "97005",
      "97217", "97203", "97211", "97212", "97218",
      "97213", "97215", "97216", "97230", "97233",
      "97034", "97035", "97036", "97219", "97239",
      "97210", "97231"
    ];

    const input = document.getElementById('zip-input');
    const btn = document.getElementById('check-zip-btn');
    const result = document.getElementById('zip-result');

    function checkZip() {
      const val = input?.value.trim();
      if (!val || val.length !== 5) {
        result.className = "text-small p-12 rounded-md font-medium bg-amber-50 text-amber-900 border border-amber-200 block";
        result.textContent = "Please enter a valid 5-digit ZIP code.";
        return;
      }

      if (coveredZips.includes(val)) {
        result.className = "text-small p-12 rounded-md font-medium bg-emerald-50 text-emerald-900 border border-emerald-200 block";
        result.innerHTML = `<strong>Great news!</strong> ZIP code <strong>${val}</strong> is fully covered by our priority mobile fleet. Average response time: <strong>35–50 minutes</strong>. <a href="/book" class="underline font-bold text-emerald-800 ml-4">Book service now &rarr;</a>`;
      } else {
        result.className = "text-small p-12 rounded-md font-medium bg-blue-50 text-brand-primary border border-blue-200 block";
        result.innerHTML = `ZIP <strong>${val}</strong> is on our extended service boundary. Please call our central dispatch directly at <a href="tel:5550147824" class="underline font-bold">(555) 014-7824</a> to check current on-call van availability.`;
      }
    }

    btn?.addEventListener('click', checkZip);
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') checkZip();
    });
  </script>
</Layout>
