---
import Layout from '@/layouts/Layout.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Accordion from '@/components/ui/Accordion.astro';
import CTABanner from '@/components/sections/CTABanner.astro';

const faqs = [
  {
    question: "How fast do you respond to online contact submissions?",
    answer: "During standard business hours, an on-call dispatcher responds to form inquiries within 15 minutes. For immediate emergencies, we always recommend calling our 24/7 hotline directly at (555) 014-7824."
  },
  {
    question: "Do you provide estimates over the phone?",
    answer: "We provide upfront flat diagnostic rates and approximate replacement pricing over the phone. For repairs, because heating and cooling systems contain complex interrelated electrical, refrigeration, and airflow components, an on-site mechanical inspection is necessary before issuing a firm written quote."
  },
  {
    question: "What is your emergency dispatch radius?",
    answer: "We cover all major municipalities across a 35-mile radius from our central dispatch depot, including central metro, west valley, north suburbs, and eastside districts."
  }
];
---

<Layout 
  title="Contact Us & 24/7 Dispatch — NorthStar HVAC" 
  description="Contact NorthStar HVAC for immediate 24/7 emergency dispatch, service inquiries, or free replacement estimates. Direct phone: (555) 014-7824."
>
  <!-- Hero Section -->
  <section class="bg-neutral-bg border-b border-neutral-border py-64 md:py-80">
    <div class="container">
      <div class="max-w-3xl space-y-16">
        <Badge variant="info">24/7 CUSTOMER SUPPORT &amp; DISPATCH</Badge>
        <h1 class="text-h1 font-heading font-extrabold text-brand-primary leading-tight">
          We're Ready to Help You 24 Hours a Day, 7 Days a Week
        </h1>
        <p class="text-body text-text-secondary leading-relaxed">
          Have an urgent heating or cooling emergency, need to schedule seasonal maintenance, or want to discuss financing options? Our local dispatch team is ready to assist you.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Info Grid & Form Section -->
  <section class="py-80 bg-neutral-surface">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-48 items-start">
        <!-- Contact Info Cards (Left Column) -->
        <div class="lg:col-span-5 space-y-24">
          <!-- Emergency Hotline Card -->
          <div class="bg-red-50 border-2 border-red-200 p-20 sm:p-28 rounded-xl space-y-12">
            <div class="flex items-center gap-10">
              <span class="w-10 h-10 rounded-full bg-red-600 animate-pulse"></span>
              <span class="text-caption font-bold uppercase tracking-wider text-red-900">
                24/7 Live Emergency Line
              </span>
            </div>
            <div>
              <a href="tel:5550147824" class="text-h3 sm:text-h2 font-heading font-extrabold text-red-700 hover:text-red-800 transition-colors block">
                (555) 014-7824
              </a>
              <span class="text-small text-red-900/80">Direct connection to on-call master technician</span>
            </div>
          </div>

          <!-- General Office Info -->
          <div class="bg-neutral-bg border border-neutral-border p-20 sm:p-28 md:p-32 rounded-xl space-y-20 sm:space-y-24 shadow-sm">
            <div class="flex items-start gap-16">
              <div class="w-40 h-40 rounded-md bg-blue-50 text-brand-primary flex items-center justify-center shrink-0">
                <Icon name="mail" size={20} />
              </div>
              <div>
                <strong class="block text-small text-brand-primary">Email Support</strong>
                <a href="mailto:service@northstarhvac.com" class="text-small text-brand-accent hover:underline">
                  service@northstarhvac.com
                </a>
                <span class="block text-caption text-text-muted mt-2">Replies within 15–30 minutes</span>
              </div>
            </div>

            <div class="flex items-start gap-16">
              <div class="w-40 h-40 rounded-md bg-amber-50 text-brand-accent flex items-center justify-center shrink-0">
                <Icon name="map-pin" size={20} />
              </div>
              <div>
                <strong class="block text-small text-brand-primary">Dispatch Headquarters</strong>
                <p class="text-small text-text-secondary">
                  4820 Industrial Blvd, Suite 104<br />
                  Metro City, ST 97201
                </p>
              </div>
            </div>

            <div class="flex items-start gap-16">
              <div class="w-40 h-40 rounded-md bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                <Icon name="clock" size={20} />
              </div>
              <div>
                <strong class="block text-small text-brand-primary">Operating Hours</strong>
                <p class="text-small text-text-secondary">
                  Standard: Mon – Sat: 7:00 AM – 7:00 PM<br />
                  Emergency Dispatch: <strong>24/7/365 Available</strong>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form (Right Column) -->
        <div class="lg:col-span-7 bg-neutral-bg border border-neutral-border p-32 md:p-48 rounded-xl shadow-sm space-y-24">
          <div>
            <span class="text-caption font-bold tracking-wider text-brand-accent uppercase">Send a Message</span>
            <h2 class="text-h2 font-heading font-bold text-brand-primary mt-4">
              How Can We Help You Today?
            </h2>
          </div>

          <form id="contact-form" class="space-y-20">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-20">
              <div>
                <label for="contact-name" class="block text-small font-heading font-bold text-brand-primary mb-6">
                  Full Name *
                </label>
                <input 
                  type="text" 
                  id="contact-name" 
                  required
                  placeholder="e.g. Amanda Roberts"
                  class="w-full px-16 py-12 border border-neutral-border rounded-md text-small bg-neutral-surface focus:border-brand-primary focus:ring-1 focus:ring-brand-primary outline-none"
                />
              </div>

              <div>
                <label for="contact-phone" class="block text-small font-heading font-bold text-brand-primary mb-6">
                  Phone Number *
                </label>
                <input 
                  type="tel" 
                  id="contact-phone" 
                  required
                  placeholder="e.g. (555) 234-5678"
                  class="w-full px-16 py-12 border border-neutral-border rounded-md text-small bg-neutral-surface focus:border-brand-primary focus:ring-1 focus:ring-brand-primary outline-none"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-20">
              <div>
                <label for="contact-email" class="block text-small font-heading font-bold text-brand-primary mb-6">
                  Email Address *
                </label>
                <input 
                  type="email" 
                  id="contact-email" 
                  required
                  placeholder="e.g. amanda@example.com"
                  class="w-full px-16 py-12 border border-neutral-border rounded-md text-small bg-neutral-surface focus:border-brand-primary focus:ring-1 focus:ring-brand-primary outline-none"
                />
              </div>

              <div>
                <label for="contact-service" class="block text-small font-heading font-bold text-brand-primary mb-6">
                  Service Inquiring About
                </label>
                <select 
                  id="contact-service"
                  class="w-full px-16 py-12 border border-neutral-border rounded-md text-small bg-neutral-surface focus:border-brand-primary focus:ring-1 focus:ring-brand-primary outline-none"
                >
                  <option value="Air Conditioning Repair">Air Conditioning Repair</option>
                  <option value="Furnace & Heating Fix">Furnace &amp; Heating Fix</option>
                  <option value="24-Point Annual Tune-Up">24-Point Annual Tune-Up</option>
                  <option value="Emergency Breakdown">Emergency Breakdown</option>
                  <option value="Heat Pump / System Replacement">Heat Pump / System Replacement</option>
                  <option value="General Question">General Question</option>
                </select>
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-small font-heading font-bold text-brand-primary mb-6">
                Tell Us About Your System or Issue *
              </label>
              <textarea 
                id="contact-message" 
                rows="4" 
                required
                placeholder="What brand is your system? What symptoms are you noticing (no heat, strange noise, water leak)?"
                class="w-full px-16 py-12 border border-neutral-border rounded-md text-small bg-neutral-surface focus:border-brand-primary focus:ring-1 focus:ring-brand-primary outline-none"
              ></textarea>
            </div>

            <div id="contact-success-msg" class="hidden p-16 rounded-md text-small font-medium bg-emerald-50 text-emerald-900 border border-emerald-200">
              <strong>Message Sent Successfully!</strong> An on-call NorthStar dispatcher has received your details and will contact you within 15 minutes.
            </div>

            <button 
              type="submit" 
              class="w-full sm:w-auto px-32 py-14 bg-brand-primary text-white font-bold rounded-md hover:bg-brand-secondary transition-colors text-small flex items-center justify-center gap-8"
            >
              <span>Send Message</span>
              <Icon name="arrow-right" size={16} />
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-80 bg-neutral-bg border-y border-neutral-border">
    <div class="container max-w-3xl space-y-40">
      <div class="text-center space-y-12">
        <span class="text-caption font-bold tracking-wider text-brand-accent uppercase">Common Inquiries</span>
        <h2 class="text-h2 font-heading font-bold text-brand-primary">
          Frequently Asked Contact Questions
        </h2>
      </div>

      <Accordion items={faqs} />
    </div>
  </section>

  <!-- CTA Banner -->
  <CTABanner
    title="Need Immediate Service Right Now?"
    subtitle="Skip the wait and schedule your arrival window online directly."
    primaryCta={{ label: "Book a Service", href: "/book" }}
    secondaryCta={{ label: "24/7 Hotline: (555) 014-7824", href: "tel:5550147824" }}
    variant="primary"
  />

  <!-- Interactive Form Script -->
  <script is:inline>
    const form = document.getElementById('contact-form');
    const msg = document.getElementById('contact-success-msg');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      msg.classList.remove('hidden');
      form.reset();
      setTimeout(() => {
        msg.scrollIntoView({ behavior: 'smooth' });
      }, 100);
    });
  </script>
</Layout>
