---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db, ensureDbInitialized } from '../../../lib/db';

await ensureDbInitialized();

const url = new URL(Astro.request.url);
const currentFilter = url.searchParams.get('filter') || 'all';
const searchQuery = url.searchParams.get('q')?.trim() || '';

let sql = 'SELECT * FROM reviews';
const conditions: string[] = [];
const args: any[] = [];

if (currentFilter === 'pending') {
  conditions.push('is_approved = 0');
} else if (currentFilter === 'approved') {
  conditions.push('is_approved = 1');
}

if (searchQuery) {
  conditions.push('(author_name LIKE ? OR content LIKE ? OR service_type LIKE ?)');
  const term = `%${searchQuery}%`;
  args.push(term, term, term);
}

if (conditions.length > 0) {
  sql += ' WHERE ' + conditions.join(' AND ');
}

sql += ' ORDER BY is_approved ASC, is_featured DESC, created_at DESC';

const [reviewsRes, countsRes] = await Promise.all([
  db.execute({ sql, args }),
  db.execute(`
    SELECT
      COUNT(*) as total,
      SUM(CASE WHEN is_approved = 1 THEN 1 ELSE 0 END) as approved,
      SUM(CASE WHEN is_approved = 0 THEN 1 ELSE 0 END) as pending
    FROM reviews
  `)
]);

const reviews = reviewsRes.rows;
const totalCount = Number(countsRes.rows[0]?.total || 0);
const approvedCount = Number(countsRes.rows[0]?.approved || 0);
const pendingCount = Number(countsRes.rows[0]?.pending || 0);
---

<AdminLayout
  title="Customer Reviews"
  activeSection="reviews"
  breadcrumbs={[{ label: 'Reviews' }]}
>
  <!-- Toast Notification Container -->
  <div id="toast" class="hidden fixed bottom-24 right-24 z-50 px-20 py-12 rounded-md shadow-lg text-small font-semibold text-white transition-all transform duration-300"></div>

  <!-- Page Header -->
  <div class="mb-32 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-16">
    <div>
      <h1 class="text-h2 font-heading font-extrabold text-brand-primary tracking-tight">Customer Reviews &amp; Moderation</h1>
      <p class="text-small text-text-muted mt-4">
        Moderate customer testimonials before they go live on the public website.
      </p>
    </div>

    <div>
      <button
        id="btn-add-review"
        class="inline-flex items-center gap-8 h-40 px-16 bg-brand-accent hover:bg-brand-accent-hover text-white text-small font-semibold rounded-md shadow-sm hover:shadow transition-all cursor-pointer"
      >
        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Add Customer Review
      </button>
    </div>
  </div>

  <!-- Filter Tabs & Search Bar -->
  <div class="bg-neutral-surface rounded-lg border border-neutral-border p-16 mb-24 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-16">
    <!-- Filter Tabs -->
    <div class="flex items-center gap-8 overflow-x-auto pb-4 md:pb-0">
      <a
        href="/admin/reviews?filter=all"
        class={`h-36 px-16 rounded-md text-small font-semibold transition-all inline-flex items-center gap-8 whitespace-nowrap ${
          currentFilter === 'all'
            ? 'bg-brand-primary text-white shadow-sm'
            : 'bg-neutral-surface-alt text-text-secondary hover:bg-neutral-border/50'
        }`}
      >
        <span>All Reviews</span>
        <span class="opacity-75">({totalCount})</span>
      </a>

      <a
        href="/admin/reviews?filter=pending"
        class={`h-36 px-16 rounded-md text-small font-semibold transition-all inline-flex items-center gap-8 whitespace-nowrap ${
          currentFilter === 'pending'
            ? 'bg-amber-600 text-white shadow-sm'
            : 'bg-amber-50 text-amber-800 hover:bg-amber-100 border border-amber-200'
        }`}
      >
        <span>Pending Approval</span>
        <span class={`px-8 py-2 rounded-full text-caption font-bold ${currentFilter === 'pending' ? 'bg-white text-amber-700' : 'bg-amber-200 text-amber-900'}`}>
          {pendingCount}
        </span>
      </a>

      <a
        href="/admin/reviews?filter=approved"
        class={`h-36 px-16 rounded-md text-small font-semibold transition-all inline-flex items-center gap-8 whitespace-nowrap ${
          currentFilter === 'approved'
            ? 'bg-feedback-success text-white shadow-sm'
            : 'bg-emerald-50 text-emerald-800 hover:bg-emerald-100 border border-emerald-200'
        }`}
      >
        <span>Live on Website</span>
        <span class="opacity-75">({approvedCount})</span>
      </a>
    </div>

    <!-- Search Form -->
    <form method="GET" action="/admin/reviews" class="relative max-w-xs w-full">
      <input type="hidden" name="filter" value={currentFilter} />
      <input
        type="text"
        name="q"
        value={searchQuery}
        placeholder="Enter keyword or author to search reviews..."
        class="w-full h-36 pl-36 pr-16 text-small bg-neutral-surface border border-neutral-border rounded-md text-text-primary placeholder:text-text-muted focus:outline-none focus:border-brand-primary"
      />
      <div class="absolute inset-y-0 left-0 pl-12 flex items-center pointer-events-none text-text-muted">
        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </form>
  </div>

  <!-- Reviews Table / List Card -->
  <div class="bg-neutral-surface rounded-lg border border-neutral-border shadow-sm overflow-hidden">
    {reviews.length === 0 ? (
      <div class="p-48 text-center">
        <div class="w-48 h-48 rounded-full bg-neutral-surface-alt text-text-muted flex items-center justify-center mx-auto mb-16">
          <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
        </div>
        <h3 class="text-body font-heading font-bold text-brand-primary">No reviews found</h3>
        <p class="text-small text-text-muted mt-4 max-w-sm mx-auto">
          {searchQuery ? `No results matching "${searchQuery}". Try a different keyword.` : 'There are no reviews in this view category.'}
        </p>
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-neutral-border bg-neutral-surface-alt/75 text-caption font-heading font-bold text-text-secondary uppercase tracking-wider">
              <th class="py-14 px-20">Author &amp; Location</th>
              <th class="py-14 px-20">Rating</th>
              <th class="py-14 px-20">Service</th>
              <th class="py-14 px-20">Review Content</th>
              <th class="py-14 px-20">Status</th>
              <th class="py-14 px-20">Featured</th>
              <th class="py-14 px-20 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-border/80 text-small">
            {reviews.map((rev) => {
              const isApproved = Number(rev.is_approved) === 1;
              const isFeatured = Number(rev.is_featured) === 1;
              const rating = Number(rev.rating);

              return (
                <tr class="hover:bg-neutral-surface-alt/40 transition-colors" id={`row-${rev.id}`}>
                  <!-- Author -->
                  <td class="py-16 px-20 font-semibold text-text-primary whitespace-nowrap">
                    <div class="text-small font-bold">{rev.author_name}</div>
                    <div class="text-caption text-text-muted font-normal mt-2">{rev.author_location}</div>
                  </td>

                  <!-- Rating -->
                  <td class="py-16 px-20 whitespace-nowrap">
                    <div class="flex items-center text-amber-500 font-bold gap-6">
                      <span>{rating}</span>
                      <svg class="w-16 h-16 fill-current" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    </div>
                  </td>

                  <!-- Service -->
                  <td class="py-16 px-20 text-text-secondary whitespace-nowrap">
                    <span class="inline-block px-10 py-4 rounded-md bg-neutral-surface-alt text-text-secondary text-caption font-medium border border-neutral-border">
                      {rev.service_type}
                    </span>
                  </td>

                  <!-- Content snippet -->
                  <td class="py-16 px-20 text-text-secondary max-w-xs md:max-w-md">
                    <p class="line-clamp-2 leading-relaxed text-small" title={rev.content as string}>
                      "{rev.content}"
                    </p>
                  </td>

                  <!-- Status Badge & Inline Toggle -->
                  <td class="py-16 px-20 whitespace-nowrap">
                    <button
                      class={`btn-toggle-approve inline-flex items-center gap-6 px-10 py-4 rounded-full text-caption font-bold cursor-pointer transition-all border ${
                        isApproved
                          ? 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100'
                          : 'bg-amber-50 text-amber-800 border-amber-200 hover:bg-amber-100'
                      }`}
                      data-id={rev.id}
                      data-status={isApproved ? '1' : '0'}
                      title={isApproved ? 'Click to unapprove' : 'Click to approve for public site'}
                    >
                      <span class={`w-6 h-6 rounded-full shrink-0 ${isApproved ? 'bg-emerald-500' : 'bg-amber-500'}`}></span>
                      {isApproved ? 'Approved' : 'Pending'}
                    </button>
                  </td>

                  <!-- Featured Badge & Inline Toggle -->
                  <td class="py-16 px-20 whitespace-nowrap">
                    <button
                      class={`btn-toggle-feature inline-flex items-center gap-4 px-10 py-4 rounded-md text-caption font-semibold cursor-pointer transition-all border ${
                        isFeatured
                          ? 'bg-indigo-50 text-indigo-700 border-indigo-200 hover:bg-indigo-100 font-bold'
                          : 'text-text-muted hover:text-brand-primary border-transparent hover:border-neutral-border'
                      }`}
                      data-id={rev.id}
                      data-featured={isFeatured ? '1' : '0'}
                      title="Toggle featured status"
                    >
                      {isFeatured ? '★ Featured' : 'Standard'}
                    </button>
                  </td>

                  <!-- Actions -->
                  <td class="py-16 px-20 text-right whitespace-nowrap">
                    <button
                      class="btn-edit-review inline-flex items-center h-32 px-12 text-text-secondary hover:text-brand-primary hover:bg-neutral-surface-alt rounded-md text-caption font-semibold transition-colors cursor-pointer mr-8 border border-neutral-border"
                      data-id={rev.id}
                      data-author={rev.author_name}
                      data-location={rev.author_location}
                      data-rating={rev.rating}
                      data-service={rev.service_type}
                      data-content={rev.content}
                      data-approved={rev.is_approved}
                      data-featured={rev.is_featured}
                    >
                      Edit
                    </button>

                    <button
                      class="btn-delete-review inline-flex items-center h-32 px-12 text-brand-emergency hover:bg-red-50 rounded-md text-caption font-semibold transition-colors cursor-pointer border border-brand-emergency/20"
                      data-id={rev.id}
                      data-author={rev.author_name}
                    >
                      Delete
                    </button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <!-- CREATE / EDIT MODAL -->
  <div id="review-modal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-brand-primary/60 backdrop-blur-sm flex items-center justify-center p-16 sm:p-24">
    <div class="bg-neutral-surface rounded-lg border border-neutral-border shadow-hover max-w-xl w-full p-24 sm:p-32 relative">
      <div class="flex items-center justify-between pb-16 border-b border-neutral-border">
        <h3 id="modal-title" class="text-body-large font-heading font-bold text-brand-primary">Add New Customer Review</h3>
        <button id="modal-close" class="text-text-muted hover:text-brand-primary text-body font-bold cursor-pointer p-4">&times;</button>
      </div>

      <form id="review-form" class="mt-20 space-y-16">
        <input type="hidden" id="form-review-id" value="" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-16">
          <div>
            <label for="form-author" class="block text-caption font-heading font-bold uppercase tracking-wider text-text-secondary mb-6 flex items-center justify-between">
              <span>Author Name *</span>
              <span class="text-[10px] text-brand-accent font-normal">Enter to change</span>
            </label>
            <input
              type="text"
              id="form-author"
              required
              placeholder="Enter customer author name to change..."
              class="w-full h-40 px-14 text-small bg-neutral-surface border border-neutral-border rounded-md text-text-primary focus:outline-none focus:border-brand-primary"
            />
          </div>

          <div>
            <label for="form-location" class="block text-caption font-heading font-bold uppercase tracking-wider text-text-secondary mb-6 flex items-center justify-between">
              <span>Customer Location</span>
              <span class="text-[10px] text-brand-accent font-normal">Enter to change</span>
            </label>
            <input
              type="text"
              id="form-location"
              placeholder="Enter customer location to change (e.g. Minneapolis, MN)..."
              class="w-full h-40 px-14 text-small bg-neutral-surface border border-neutral-border rounded-md text-text-primary focus:outline-none focus:border-brand-primary"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-16">
          <div>
            <label for="form-rating" class="block text-caption font-heading font-bold uppercase tracking-wider text-text-secondary mb-6 flex items-center justify-between">
              <span>Rating *</span>
              <span class="text-[10px] text-brand-accent font-normal">Select to change</span>
            </label>
            <select
              id="form-rating"
              required
              class="w-full h-40 px-14 text-small bg-neutral-surface border border-neutral-border rounded-md text-text-primary focus:outline-none focus:border-brand-primary cursor-pointer"
            >
              <option value="5">★★★★★ (5 Stars - Excellent)</option>
              <option value="4">★★★★☆ (4 Stars - Good)</option>
              <option value="3">★★★☆☆ (3 Stars - Average)</option>
              <option value="2">★★☆☆☆ (2 Stars - Below Average)</option>
              <option value="1">★☆☆☆☆ (1 Star - Poor)</option>
            </select>
          </div>

          <div>
            <label for="form-service" class="block text-caption font-heading font-bold uppercase tracking-wider text-text-secondary mb-6 flex items-center justify-between">
              <span>Service Category</span>
              <span class="text-[10px] text-brand-accent font-normal">Enter to change</span>
            </label>
            <input
              type="text"
              id="form-service"
              placeholder="Enter service category to change (e.g. AC Repair)..."
              class="w-full h-40 px-14 text-small bg-neutral-surface border border-neutral-border rounded-md text-text-primary focus:outline-none focus:border-brand-primary"
            />
          </div>
        </div>

        <div>
          <label for="form-content" class="block text-caption font-heading font-bold uppercase tracking-wider text-text-secondary mb-6 flex items-center justify-between">
            <span>Review Content *</span>
            <span class="text-[10px] text-brand-accent font-normal">Enter to change</span>
          </label>
          <textarea
            id="form-content"
            rows="4"
            required
            placeholder="Enter customer review testimonial content to change..."
            class="w-full p-14 text-small bg-neutral-surface border border-neutral-border rounded-md text-text-primary focus:outline-none focus:border-brand-primary"
          ></textarea>
        </div>

        <div class="pt-12 border-t border-neutral-border space-y-8">
          <label class="flex items-center gap-8 cursor-pointer text-small font-medium text-text-secondary">
            <input type="checkbox" id="form-approved" class="rounded border-neutral-border text-brand-accent focus:ring-brand-accent w-16 h-16" />
            Approve immediately for live public website display
          </label>

          <label class="flex items-center gap-8 cursor-pointer text-small font-medium text-text-secondary">
            <input type="checkbox" id="form-featured" class="rounded border-neutral-border text-brand-accent focus:ring-brand-accent w-16 h-16" />
            Pin as Featured Testimonial
          </label>
        </div>

        <div class="mt-24 flex items-center justify-end gap-12 pt-16 border-t border-neutral-border">
          <button
            type="button"
            id="form-cancel"
            class="h-40 px-16 border border-neutral-border rounded-md text-small font-semibold text-text-secondary hover:bg-neutral-surface-alt cursor-pointer transition-colors"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="form-submit"
            class="h-40 px-20 bg-brand-accent hover:bg-brand-accent-hover text-white text-small font-semibold rounded-md shadow-sm hover:shadow cursor-pointer transition-all"
          >
            Save Review
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- DELETE CONFIRMATION MODAL (MANDATORY PER SKILL) -->
  <div id="delete-modal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-brand-primary/60 backdrop-blur-sm flex items-center justify-center p-16 sm:p-24">
    <div class="bg-neutral-surface rounded-lg border border-neutral-border shadow-hover max-w-md w-full p-24 sm:p-32">
      <div class="w-44 h-44 rounded-full bg-red-100 text-brand-emergency flex items-center justify-center mb-16">
        <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
      </div>

      <h3 class="text-body-large font-heading font-bold text-brand-primary">Confirm Review Deletion</h3>
      <p class="text-small text-text-muted mt-8 leading-relaxed">
        Are you sure you want to permanently delete the review from <span id="delete-author-name" class="font-bold text-text-primary"></span>?
        This action cannot be undone and will immediately remove it from both the admin records and the public website.
      </p>

      <div class="mt-24 flex items-center justify-end gap-12">
        <button
          type="button"
          id="delete-cancel"
          class="h-40 px-16 border border-neutral-border rounded-md text-small font-semibold text-text-secondary hover:bg-neutral-surface-alt cursor-pointer transition-colors"
        >
          Cancel
        </button>
        <button
          type="button"
          id="delete-confirm"
          class="h-40 px-20 bg-brand-emergency hover:bg-brand-emergency-hover text-white text-small font-semibold rounded-md shadow-sm hover:shadow cursor-pointer transition-all"
        >
          Yes, Delete Review
        </button>
      </div>
    </div>
  </div>

  <script>
    function getCsrfToken(): string {
      const meta = document.querySelector('meta[name="csrf-token"]') as HTMLMetaElement;
      return meta?.content || (window as any).__CSRF_TOKEN__ || '';
    }

    function showToast(message: string, isError = false) {
      const toast = document.getElementById('toast');
      if (!toast) return;
      toast.textContent = message;
      toast.className = `fixed bottom-24 right-24 z-50 px-20 py-12 rounded-md shadow-lg text-small font-semibold text-white transition-all transform duration-300 ${
        isError ? 'bg-brand-emergency' : 'bg-brand-primary'
      }`;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 3500);
    }

    // Modal elements
    const reviewModal = document.getElementById('review-modal') as HTMLElement;
    const deleteModal = document.getElementById('delete-modal') as HTMLElement;
    const btnAdd = document.getElementById('btn-add-review');
    const modalClose = document.getElementById('modal-close');
    const formCancel = document.getElementById('form-cancel');
    const deleteCancel = document.getElementById('delete-cancel');
    const reviewForm = document.getElementById('review-form') as HTMLFormElement;
    const modalTitle = document.getElementById('modal-title') as HTMLElement;

    // Form inputs
    const formId = document.getElementById('form-review-id') as HTMLInputElement;
    const formAuthor = document.getElementById('form-author') as HTMLInputElement;
    const formLocation = document.getElementById('form-location') as HTMLInputElement;
    const formRating = document.getElementById('form-rating') as HTMLSelectElement;
    const formService = document.getElementById('form-service') as HTMLInputElement;
    const formContent = document.getElementById('form-content') as HTMLTextAreaElement;
    const formApproved = document.getElementById('form-approved') as HTMLInputElement;
    const formFeatured = document.getElementById('form-featured') as HTMLInputElement;

    // Delete state
    let pendingDeleteId: string | null = null;
    const deleteAuthorName = document.getElementById('delete-author-name') as HTMLElement;
    const deleteConfirm = document.getElementById('delete-confirm');

    // Open Add Modal
    btnAdd?.addEventListener('click', () => {
      modalTitle.textContent = 'Add New Customer Review';
      formId.value = '';
      reviewForm.reset();
      formApproved.checked = true;
      reviewModal.classList.remove('hidden');
    });

    // Close Modals
    modalClose?.addEventListener('click', () => reviewModal.classList.add('hidden'));
    formCancel?.addEventListener('click', () => reviewModal.classList.add('hidden'));
    deleteCancel?.addEventListener('click', () => deleteModal.classList.add('hidden'));

    // Edit Review click
    document.querySelectorAll('.btn-edit-review').forEach(btn => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        modalTitle.textContent = 'Edit Customer Review';
        formId.value = el.dataset.id || '';
        formAuthor.value = el.dataset.author || '';
        formLocation.value = el.dataset.location || '';
        formRating.value = el.dataset.rating || '5';
        formService.value = el.dataset.service || '';
        formContent.value = el.dataset.content || '';
        formApproved.checked = el.dataset.approved === '1';
        formFeatured.checked = el.dataset.featured === '1';
        reviewModal.classList.remove('hidden');
      });
    });

    // Save Form (Create or Update)
    reviewForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = formId.value;
      const isEdit = !!id;

      const payload = {
        author_name: formAuthor.value,
        author_location: formLocation.value,
        rating: Number(formRating.value),
        service_type: formService.value,
        content: formContent.value,
        is_approved: formApproved.checked ? 1 : 0,
        is_featured: formFeatured.checked ? 1 : 0,
      };

      try {
        const url = isEdit ? `/api/admin/reviews/${id}` : '/api/admin/reviews';
        const method = isEdit ? 'PUT' : 'POST';

        const res = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken()
          },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (res.ok) {
          showToast(isEdit ? 'Review updated successfully.' : 'Review created successfully.');
          reviewModal.classList.add('hidden');
          setTimeout(() => window.location.reload(), 600);
        } else {
          showToast(data.error || 'Operation failed', true);
        }
      } catch (err: any) {
        showToast('Network error: ' + err.message, true);
      }
    });

    // Delete Trigger
    document.querySelectorAll('.btn-delete-review').forEach(btn => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        pendingDeleteId = el.dataset.id || null;
        deleteAuthorName.textContent = el.dataset.author || 'this customer';
        deleteModal.classList.remove('hidden');
      });
    });

    // Delete Confirm
    deleteConfirm?.addEventListener('click', async () => {
      if (!pendingDeleteId) return;

      try {
        const res = await fetch(`/api/admin/reviews/${pendingDeleteId}`, {
          method: 'DELETE',
          headers: {
            'X-CSRF-Token': getCsrfToken()
          }
        });

        if (res.ok) {
          showToast('Review permanently deleted.');
          deleteModal.classList.add('hidden');
          const row = document.getElementById(`row-${pendingDeleteId}`);
          row?.remove();
        } else {
          const data = await res.json();
          showToast(data.error || 'Failed to delete review', true);
        }
      } catch (err: any) {
        showToast('Error: ' + err.message, true);
      }
    });

    // Quick inline Approve Toggle
    document.querySelectorAll('.btn-toggle-approve').forEach(btn => {
      btn.addEventListener('click', async () => {
        const el = btn as HTMLElement;
        const id = el.dataset.id;
        const current = el.dataset.status === '1';
        const newStatus = !current;

        try {
          const res = await fetch(`/api/admin/reviews/${id}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': getCsrfToken()
            },
            body: JSON.stringify({ is_approved: newStatus ? 1 : 0 })
          });

          if (res.ok) {
            showToast(newStatus ? 'Review approved for public display!' : 'Review unapproved and moved to pending.');
            setTimeout(() => window.location.reload(), 400);
          } else {
            showToast('Failed to update status', true);
          }
        } catch (e: any) {
          showToast('Error: ' + e.message, true);
        }
      });
    });

    // Quick inline Featured Toggle
    document.querySelectorAll('.btn-toggle-feature').forEach(btn => {
      btn.addEventListener('click', async () => {
        const el = btn as HTMLElement;
        const id = el.dataset.id;
        const current = el.dataset.featured === '1';
        const newStatus = !current;

        try {
          const res = await fetch(`/api/admin/reviews/${id}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': getCsrfToken()
            },
            body: JSON.stringify({ is_featured: newStatus ? 1 : 0 })
          });

          if (res.ok) {
            showToast(newStatus ? 'Review pinned as Featured.' : 'Review unmarked from featured.');
            setTimeout(() => window.location.reload(), 400);
          } else {
            showToast('Failed to update status', true);
          }
        } catch (e: any) {
          showToast('Error: ' + e.message, true);
        }
      });
    });
  </script>
</AdminLayout>
