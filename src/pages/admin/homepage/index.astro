---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
import defaultServices from '@/content/services.json';
import defaultReviews from '@/content/reviews.json';
import { db, ensureDbInitialized, getHomepageSections, getSiteSettings } from '@/lib/db';

await ensureDbInitialized();

const [sections, siteSettings, dbServicesRes, dbReviewsRes, mediaRes] = await Promise.all([
  getHomepageSections(),
  getSiteSettings(),
  db.execute('SELECT * FROM services WHERE is_active = 1 ORDER BY display_order ASC, created_at DESC LIMIT 6'),
  db.execute('SELECT * FROM reviews WHERE is_approved = 1 ORDER BY is_featured DESC, created_at DESC LIMIT 6'),
  db.execute('SELECT id, file_name, url, alt_text, mime_type, file_size FROM media ORDER BY created_at DESC LIMIT 50')
]);

const mediaList = mediaRes.rows;

// Helper to safely parse JSON
function safeJson(str: string, fallback: any = {}) {
  try {
    return JSON.parse(str || '{}');
  } catch {
    return fallback;
  }
}

// 1. Hero
const hero = sections['hero'] || {
  title: 'Reliable Heating & AC Solutions for Lasting Comfort.',
  subtitle: 'From precision emergency AC repairs to high-efficiency furnace installations, licensed NorthStar technicians deliver transparent flat-rate pricing and respectful service across your neighborhood.',
  badge: 'Fast Same-Day Response Guaranteed',
  image_url: '/images/hero-technician-ac.jpg',
  image_alt: 'Certified NorthStar HVAC technician testing outdoor condensing unit with digital manifold gauges',
  primary_btn_text: 'Schedule Service',
  primary_btn_url: '/book',
  secondary_btn_text: siteSettings['phone_primary'] ? `Call ${siteSettings['phone_primary']}` : 'Call (555) 014-7824',
  secondary_btn_url: siteSettings['phone_raw'] ? `tel:${siteSettings['phone_raw']}` : 'tel:5550147824',
  is_enabled: 1
};
const heroExtra = safeJson(hero.extra_data_json, {
  rating_score: '4.9 / 5.0 Rating',
  rating_subtext: 'across Google & Yelp',
  trust_card_title: 'Full 90-Day Workmanship Guarantee',
  trust_card_desc: 'Zero hidden trip charges on all diagnostic calls'
});

// 2. Trust Signals
const trustSection = sections['trust_signals'] || { is_enabled: 1 };
const trustSignals: Array<{ icon: string; title: string; text: string }> = safeJson(trustSection.extra_data_json, [
  { icon: 'shield', title: 'NATE & EPA Certified', text: 'Rigorous master technician standards' },
  { icon: 'check', title: 'Upfront Flat Pricing', text: 'Written quotes before any work begins' },
  { icon: 'star', title: '4.9★ Rated Locally', text: 'Over 1,200+ verified homeowner reviews' },
  { icon: 'clock', title: '24/7 Live Dispatch', text: 'Average 45-min emergency van response' }
]);

// 3. Services Intro
const servicesIntro = sections['services_intro'] || {
  title: 'Comprehensive HVAC Services',
  subtitle: 'Engineered for high SEER2 energy efficiency, indoor air purity, and year-round indoor comfort.',
  badge: 'PRECISION CLIMATE SOLUTIONS',
  primary_btn_text: 'Explore All Services',
  primary_btn_url: '/services',
  is_enabled: 1
};
const services = dbServicesRes.rows.length > 0
  ? dbServicesRes.rows.map(s => ({
      id: s.id as string,
      slug: s.slug as string,
      title: s.title as string,
      category: 'Residential HVAC',
      badge: Number(s.starting_price) > 0 ? `From $${Number(s.starting_price).toFixed(0)}` : 'Flat Rate',
      icon: 'wrench',
      shortDescription: s.short_desc as string,
      fullDescription: s.full_desc as string
    }))
  : defaultServices.map((s, i) => ({ ...s, id: `svc_default_${i}` }));

// 4. Emergency CTA
const emergencyCta = sections['emergency_cta'] || {
  badge: 'URGENT EMERGENCY CALLOUT',
  title: 'HVAC Failure During Extreme Weather?',
  subtitle: 'Our fully stocked mobile service vans are radio-dispatched 24/7 across the metro territory with genuine OEM parts on board.',
  primary_btn_text: 'Emergency Dispatch',
  primary_btn_url: '/emergency',
  secondary_btn_text: siteSettings['emergency_phone'] ? `Call ${siteSettings['emergency_phone']}` : 'Call (555) 014-7824',
  secondary_btn_url: siteSettings['phone_raw'] ? `tel:${siteSettings['phone_raw']}` : 'tel:5550147824',
  is_enabled: 1
};

// 5. Why Choose Us
const whyUs = sections['why_us'] || {
  badge: 'THE NORTHSTAR STANDARD',
  title: 'Why Local Homeowners Trust NorthStar',
  description: 'We believe you deserve honest heating and cooling craftsmanship without manufactured sales pressure. When you call NorthStar, an experienced technician troubleshoots the root cause, explains your options clearly, and respects your home.',
  image_url: '/images/technician-furnace-inspection.jpg',
  image_alt: 'Licensed HVAC technician performing multi-point furnace combustion safety inspection',
  primary_btn_text: 'Read Our Full Story',
  primary_btn_url: '/about',
  is_enabled: 1
};
const whyUsExtra = safeJson(whyUs.extra_data_json, {
  badge_overlay: 'Clean Drop Cloth & Boot Covers on Every Call',
  features: [
    { title: 'Transparent Flat Pricing', desc: 'We quote all repairs in writing before beginning. No hidden diagnostic surprises.' },
    { title: 'Fully Stocked Service Vans', desc: 'Over 90% of cooling and heating issues fixed on the very first trip.' },
    { title: 'EPA & NATE Certified', desc: 'Work performed by technicians holding national HVAC engineering certifications.' },
    { title: 'Zero Sales Pressure', desc: 'If a repair solves your comfort issue safely, we will never force a premature replacement.' }
  ]
});

// 6. How It Works
const howItWorks = sections['how_it_works'] || {
  badge: 'SEAMLESS PROCESS',
  title: 'How It Works in 3 Simple Steps',
  subtitle: 'Restoring your home comfort should be straightforward and stress-free.',
  is_enabled: 1
};
const stepsList: Array<{ step: number; title: string; desc: string }> = safeJson(howItWorks.extra_data_json, [
  { step: 1, title: 'Schedule Online or Call', desc: 'Pick your preferred arrival window through our 60-second booking form or speak directly with our 24/7 dispatcher.' },
  { step: 2, title: 'Diagnostic & Upfront Quote', desc: 'Technician conducts digital manifold testing, identifies the problem, and presents a written flat-rate quote before touching any tools.' },
  { step: 3, title: 'Precision Fix & Guarantee', desc: 'Repairs are completed with OEM factory parts, load-tested for cooling delta T, and backed by our full 90-day guarantee.' }
]);

// 7. Service Areas
const serviceAreasSec = sections['service_areas'] || {
  badge: 'LOCAL COMMUNITY DISPATCH',
  title: 'Serving Neighborhoods Across the Metro Region',
  subtitle: 'Our radio-dispatched mobile technicians are strategically positioned for 45-minute response times.',
  primary_btn_text: 'Check Your ZIP Code',
  primary_btn_url: '/service-areas',
  is_enabled: 1
};
const serviceAreas: string[] = safeJson(serviceAreasSec.extra_data_json, [
  'Downtown Metro', 'Oak Ridge Estates', 'Westlake Heights',
  'Pine Valley', 'Riverdale Crossing', 'Eastridge Park'
]);

// 8. Reviews Section
const reviewsIntro = sections['reviews_intro'] || {
  badge: 'VERIFIED LOCAL FEEDBACK',
  title: '5-Star Reputations in Every Neighborhood',
  subtitle: 'Real feedback from local residents who trust NorthStar for honest heating and cooling craftsmanship.',
  primary_btn_text: 'View All 1,200+ Reviews',
  primary_btn_url: '/reviews',
  is_enabled: 1
};
const reviews = dbReviewsRes.rows.length > 0
  ? dbReviewsRes.rows.map(r => ({
      id: r.id as string,
      author: r.author_name as string,
      location: r.author_location as string,
      quote: r.content as string,
      rating: Number(r.rating),
      service: r.service_type as string
    }))
  : defaultReviews.map((r, i) => ({ ...r, id: `rev_default_${i}` }));

// 9. Financing Banner
const financingCta = sections['financing_cta'] || {
  badge: '0% APR AVAILABLE FOR 36 MONTHS',
  title: 'Need a Replacement System? Flexible Payment Options Available.',
  subtitle: 'Plans starting as low as $89/month for qualifying high-efficiency SEER2 heat pumps and furnaces.',
  primary_btn_text: 'Explore Financing Plans',
  primary_btn_url: '/financing',
  is_enabled: 1
};

// 10. Final CTA
const finalCta = sections['final_cta'] || {
  badge: 'PROMPT COMFORT RESTORATION',
  title: 'Restore Your Home Comfort Today',
  subtitle: 'Same-day emergency AC and furnace repair appointments available across our local service territory.',
  primary_btn_text: 'Book Service Online',
  primary_btn_url: '/book',
  secondary_btn_text: siteSettings['phone_primary'] ? `Call ${siteSettings['phone_primary']}` : 'Call (555) 014-7824',
  secondary_btn_url: siteSettings['phone_raw'] ? `tel:${siteSettings['phone_raw']}` : 'tel:5550147824',
  is_enabled: 1
};

const initialCmsData = {
  hero: { ...hero, extra: heroExtra },
  trust_signals: { ...trustSection, items: trustSignals },
  services_intro: { ...servicesIntro },
  emergency_cta: { ...emergencyCta },
  why_us: { ...whyUs, extra: whyUsExtra },
  how_it_works: { ...howItWorks, steps: stepsList },
  service_areas: { ...serviceAreasSec, areas: serviceAreas },
  reviews_intro: { ...reviewsIntro },
  financing_cta: { ...financingCta },
  final_cta: { ...finalCta }
};
---

<AdminLayout
  title="Homepage Content Management"
  activeSection="homepage"
  breadcrumbs={[{ label: 'Homepage Content Management' }]}
>
  <!-- Toast Notification Container -->
  <div id="toast" class="hidden fixed bottom-24 right-24 z-50 px-20 py-12 rounded-md shadow-2xl text-small font-semibold text-white transition-all transform duration-300"></div>

  <!-- Media Library Picker Modal -->
  <div id="media-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-16">
    <div class="bg-neutral-surface rounded-xl border border-neutral-border shadow-2xl w-full max-w-4xl max-h-[85vh] flex flex-col overflow-hidden animate-fade-in">
      <div class="px-24 py-16 border-b border-neutral-border flex items-center justify-between bg-neutral-surface-alt">
        <div class="flex items-center gap-10">
          <div class="w-32 h-32 rounded-md bg-brand-primary text-brand-accent flex items-center justify-center">
            <svg width="16" height="16" class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h3 class="text-h4 font-heading font-bold text-brand-primary">Select Image from Media Library</h3>
            <p class="text-caption text-text-muted">Click any image to assign it directly to the selected element</p>
          </div>
        </div>
        <button id="media-modal-close" class="text-text-muted hover:text-brand-primary p-6 rounded-md hover:bg-neutral-surface transition-colors" title="Close modal">
          <svg width="14" height="14" class="w-14 h-14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Search & Upload Bar -->
      <div class="p-16 border-b border-neutral-border flex flex-col sm:flex-row items-center gap-12 bg-neutral-surface">
        <div class="relative flex-1 w-full">
          <input
            type="text"
            id="media-search-input"
            placeholder="Search media by filename or alt text... (Enter to filter)"
            class="w-full h-38 pl-36 pr-12 text-small bg-neutral-surface-alt border border-neutral-border rounded-md focus:border-brand-primary focus:ring-1 focus:ring-brand-primary outline-none"
          />
          <svg width="16" height="16" class="w-16 h-16 text-text-muted absolute left-12 top-11" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <label class="h-38 px-16 bg-brand-primary hover:bg-brand-secondary text-white text-small font-semibold rounded-md flex items-center gap-8 cursor-pointer shrink-0 transition-colors">
          <svg width="16" height="16" class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          <span>Upload New Image</span>
          <input type="file" id="media-file-input" accept="image/*" class="hidden" />
        </label>
      </div>

      <!-- Media Grid -->
      <div id="media-grid-container" class="flex-1 overflow-y-auto p-20 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-16">
        {mediaList.map((m: any) => (
          <div
            class="media-item-card group relative bg-neutral-surface-alt rounded-lg border border-neutral-border hover:border-brand-accent overflow-hidden cursor-pointer transition-all hover:shadow-md"
            data-url={m.url}
            data-alt={m.alt_text || m.file_name}
            data-filename={m.file_name}
          >
            <div class="h-120 bg-neutral-surface flex items-center justify-center overflow-hidden">
              <img src={m.url} alt={m.alt_text || m.file_name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" loading="lazy" />
            </div>
            <div class="p-8 bg-neutral-surface">
              <p class="text-caption font-semibold text-brand-primary truncate">{m.file_name}</p>
              <p class="text-[11px] text-text-muted truncate">{m.alt_text || 'No alt description'}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Inline Button Popover Modal / Bubble (Directly on Button) -->
  <div id="button-inline-popover" class="hidden fixed z-50 bg-neutral-surface rounded-xl border border-brand-accent shadow-2xl p-16 w-[320px] sm:w-[360px] max-w-[90vw] animate-fade-in">
    <div class="flex items-center justify-between pb-10 mb-12 border-b border-neutral-border">
      <span class="text-caption font-bold font-heading text-brand-primary flex items-center gap-6">
        <svg width="14" height="14" class="w-14 h-14 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
        </svg>
        <span id="popover-btn-title">Configure Button</span>
      </span>
      <button type="button" id="popover-btn-close" class="text-text-muted hover:text-brand-primary p-2">
        <svg width="14" height="14" class="w-14 h-14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="space-y-12">
      <div>
        <label class="block text-caption font-bold text-text-secondary mb-4">Button Label (Enter to change)</label>
        <input type="text" id="popover-input-text" class="w-full h-34 px-10 text-small bg-neutral-surface-alt border border-neutral-border rounded-md focus:border-brand-primary outline-none" placeholder="Enter button label..." />
      </div>
      <div>
        <label class="block text-caption font-bold text-text-secondary mb-4">Destination Link (URL)</label>
        <input type="text" id="popover-input-url" class="w-full h-34 px-10 text-small bg-neutral-surface-alt border border-neutral-border rounded-md focus:border-brand-primary outline-none" placeholder="e.g. /book or tel:5550147824" />
      </div>
      <div class="pt-4 flex items-center justify-end gap-8">
        <button type="button" id="popover-btn-done" class="px-14 py-6 bg-brand-primary hover:bg-brand-secondary text-white text-caption font-bold rounded-md transition-colors">
          Apply &amp; Close
        </button>
      </div>
    </div>
  </div>

  <!-- Inline Image Popover / Overlay -->
  <div id="image-inline-popover" class="hidden fixed z-50 bg-neutral-surface rounded-xl border border-brand-accent shadow-2xl p-16 w-[320px] sm:w-[360px] max-w-[90vw] animate-fade-in">
    <div class="flex items-center justify-between pb-10 mb-12 border-b border-neutral-border">
      <span class="text-caption font-bold font-heading text-brand-primary flex items-center gap-6">
        <svg width="14" height="14" class="w-14 h-14 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Image Options</span>
      </span>
      <button type="button" id="popover-img-close" class="text-text-muted hover:text-brand-primary p-2">
        <svg width="14" height="14" class="w-14 h-14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="space-y-12">
      <div class="h-100 rounded-md overflow-hidden bg-neutral-surface-alt border border-neutral-border flex items-center justify-center">
        <img id="popover-img-preview" src="" alt="" class="w-full h-full object-cover" />
      </div>
      <button type="button" id="popover-btn-choose-media" class="w-full h-36 bg-brand-primary hover:bg-brand-secondary text-white text-caption font-bold rounded-md flex items-center justify-center gap-6 transition-colors">
        <span>Choose from Media Library</span>
      </button>
      <div>
        <label class="block text-caption font-bold text-text-secondary mb-4">Image Alt Text (Accessibility)</label>
        <input type="text" id="popover-input-img-alt" class="w-full h-34 px-10 text-small bg-neutral-surface-alt border border-neutral-border rounded-md focus:border-brand-primary outline-none" placeholder="Enter image description..." />
      </div>
      <div class="pt-4 flex items-center justify-end gap-8">
        <button type="button" id="popover-img-done" class="px-14 py-6 bg-brand-primary hover:bg-brand-secondary text-white text-caption font-bold rounded-md transition-colors">
          Done
        </button>
      </div>
    </div>
  </div>

  <!-- Sticky Top Editor Toolbar -->
  <header class="sticky top-0 z-40 bg-neutral-surface/95 backdrop-blur-md border-b border-neutral-border px-16 lg:px-24 py-12 mb-20 shadow-sm space-y-12">
    <!-- Top Row: Document Title, Live Sync Status & Primary Actions -->
    <div class="flex flex-wrap items-center justify-between gap-12">
      <!-- Title & Live Status -->
      <div class="flex items-center gap-12 min-w-0">
        <h1 class="text-h4 font-heading font-extrabold text-brand-primary tracking-tight truncate">
          Homepage Content Management
        </h1>
        <div class="inline-flex items-center gap-6 px-10 py-4 rounded-full text-caption font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80 shrink-0">
          <span class="w-6 h-6 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="hidden sm:inline">Live SSE Sync</span>
          <span class="sm:hidden">Live</span>
        </div>
      </div>

      <!-- Action Cluster: Save Status, Preview Site, Save Changes -->
      <div class="flex items-center gap-10 shrink-0">
        <!-- Save Status Badge -->
        <div
          id="save-status-pill"
          class="h-36 px-12 rounded-md bg-emerald-50 border border-emerald-200 text-caption font-semibold text-emerald-800 inline-flex items-center gap-6 transition-all whitespace-nowrap shrink-0 select-none"
        >
          <span class="w-6 h-6 rounded-full bg-emerald-500 shrink-0"></span>
          <span id="save-status-label" class="whitespace-nowrap">All changes saved</span>
        </div>

        <!-- Preview Public Site Button -->
        <a
          href="/"
          target="_blank"
          rel="noopener noreferrer"
          class="h-36 px-14 rounded-md bg-white hover:bg-neutral-surface-alt border border-neutral-border hover:border-neutral-border-focus text-brand-primary text-small font-semibold inline-flex items-center gap-8 transition-colors shadow-sm whitespace-nowrap shrink-0"
          title="Open public website in a new tab"
        >
          <svg width="14" height="14" class="w-14 h-14 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span class="whitespace-nowrap">Preview Site</span>
        </a>

        <!-- Save Changes Primary Button -->
        <button
          type="button"
          id="btn-global-save"
          class="h-36 px-16 rounded-md bg-brand-primary hover:bg-brand-secondary text-white text-small font-semibold shadow-sm inline-flex items-center gap-8 transition-all disabled:opacity-50 whitespace-nowrap shrink-0 active:scale-98"
        >
          <svg width="14" height="14" class="w-14 h-14 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
          </svg>
          <span id="btn-save-text" class="whitespace-nowrap">Save Changes</span>
        </button>
      </div>
    </div>

    <!-- Bottom Row: Canvas Controls (Viewport Switcher + Section Navigation) -->
    <div class="flex flex-wrap items-center justify-between gap-12 pt-10 border-t border-neutral-border">
      <!-- Viewport Mode Switcher -->
      <div class="flex items-center gap-10">
        <span class="text-caption font-bold text-text-muted uppercase tracking-wider text-[11px] hidden sm:inline">Viewport:</span>
        <div class="bg-neutral-surface-alt border border-neutral-border rounded-lg p-4 flex items-center gap-4 shrink-0">
          <button
            type="button"
            id="btn-view-desktop"
            class="h-32 px-12 rounded-md text-caption font-semibold bg-brand-primary text-white shadow-sm flex items-center gap-6 transition-all whitespace-nowrap shrink-0"
            title="Full Desktop View"
          >
            <svg width="14" height="14" class="w-14 h-14 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>Desktop</span>
          </button>
          <button
            type="button"
            id="btn-view-tablet"
            class="h-32 px-12 rounded-md text-caption font-semibold text-text-secondary hover:text-brand-primary hover:bg-neutral-surface flex items-center gap-6 transition-all whitespace-nowrap shrink-0"
            title="Tablet View (768px)"
          >
            <svg width="14" height="14" class="w-14 h-14 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            <span>Tablet</span>
          </button>
          <button
            type="button"
            id="btn-view-mobile"
            class="h-32 px-12 rounded-md text-caption font-semibold text-text-secondary hover:text-brand-primary hover:bg-neutral-surface flex items-center gap-6 transition-all whitespace-nowrap shrink-0"
            title="Mobile View (390px)"
          >
