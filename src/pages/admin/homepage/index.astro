              class="direct-button-editable h-48 px-24 bg-transparent border border-white/20 text-white font-semibold rounded-md flex items-center justify-center gap-8 hover:bg-white/10 w-full sm:w-auto"
              data-section="final_cta"
              data-btn-type="secondary"
              data-label-field="secondary_btn_text"
              data-url-field="secondary_btn_url"
              data-text={finalCta.secondary_btn_text || 'Call (555) 014-7824'}
              data-url={finalCta.secondary_btn_url || 'tel:5550147824'}
              title="Click to edit phone button"
            >
              <span class="btn-display-text">{finalCta.secondary_btn_text || 'Call (555) 014-7824'}</span>
              <span class="inline-flex items-center justify-center w-20 h-20 rounded bg-white/20 text-white/90 shrink-0">
                <svg width="11" height="11" class="w-11 h-11" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
              </span>
            </button>
          </div>
        </div>
      </section>

      </div>

      <!-- Bottom Device Chrome Bar (Home Indicator) -->
      <div id="device-mockup-bottom-bar" class="hidden w-full bg-slate-950 py-10 flex items-center justify-center transition-all select-none border-t border-white/5">
        <div id="device-home-indicator" class="w-32 h-[4px] bg-white/40 rounded-full"></div>
      </div>

      </div><!-- /device-screen-shell -->

    </div><!-- /device-mockup-frame -->
  </main>
</AdminLayout>

<!-- Visual Editor CSS Enhancements -->
<style is:global>
  /* Direct inline editable elements (text, headings, badges) */
  .direct-inline-editable {
    position: relative;
    cursor: text !important;
    outline: none !important;
    transition: box-shadow 0.15s ease, background-color 0.15s ease;
    border-radius: 4px;
    padding: 2px 4px;
    margin: -2px -4px;
  }
  .direct-inline-editable:hover {
    box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.4) !important;
    background-color: rgba(2, 132, 199, 0.05);
  }
  .direct-inline-editable:focus {
    box-shadow: 0 0 0 3px #0284c7 !important;
    background-color: rgba(2, 132, 199, 0.1);
  }
  .direct-inline-editable:empty::before {
    content: attr(data-placeholder);
    color: rgba(148, 163, 184, 0.8);
    pointer-events: none;
    font-style: italic;
  }

  /* Button editables */
  .direct-button-editable {
    cursor: pointer !important;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .direct-button-editable:hover {
    box-shadow: 0 0 0 3px #0284c7 !important;
  }

  /* Image editables */
  .direct-image-editable:hover {
    box-shadow: 0 0 0 4px #0284c7 !important;
  }

  /* Physical Device Mockup Chassis Styles */
  #device-mockup-frame {
    transition: max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
  }

  /* Mobile Device Template (iPhone 15 Pro style) */
  #device-mockup-frame.mode-mobile-device {
    max-width: 414px !important;
    background-color: #0f172a !important;
    border: 12px solid #0f172a !important;
    border-radius: 54px !important;
    box-shadow: 0 30px 70px -15px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.12) !important;
    position: relative !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  /* Side physical buttons for mobile template */
  #device-mockup-frame.mode-mobile-device::before {
    content: '';
    position: absolute;
    top: 100px;
    left: -16px;
    width: 4px;
    height: 28px;
    background: #475569;
    border-radius: 3px 0 0 3px;
    box-shadow: 0 44px 0 #475569, 0 94px 0 #475569;
    z-index: 10;
  }

  #device-mockup-frame.mode-mobile-device::after {
    content: '';
    position: absolute;
    top: 120px;
    right: -16px;
    width: 4px;
    height: 52px;
    background: #475569;
    border-radius: 0 3px 3px 0;
    z-index: 10;
  }

  /* Tablet Device Template (iPad style) */
  #device-mockup-frame.mode-tablet-device {
    max-width: 800px !important;
    background-color: #0f172a !important;
    border: 16px solid #0f172a !important;
    border-radius: 44px !important;
    box-shadow: 0 30px 70px -15px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.12) !important;
    position: relative !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  /* Side lock button for tablet template */
  #device-mockup-frame.mode-tablet-device::after {
    content: '';
    position: absolute;
    top: 60px;
    right: -20px;
    width: 4px;
    height: 44px;
    background: #475569;
    border-radius: 0 3px 3px 0;
    z-index: 10;
  }

  /* Ensure canvas inside device frame has NO competing border-radiuses */
  .mode-mobile-device #visual-canvas-wrapper,
  .mode-tablet-device #visual-canvas-wrapper {
    border-radius: 0 !important;
    border: none !important;
    box-shadow: none !important;
  }

  /* Screen window fit mode */
  .device-screen-window-mobile {
    max-height: 740px !important;
    overflow-y: auto !important;
    scroll-behavior: smooth;
    border-radius: 0 !important;
  }

  .device-screen-window-tablet {
    max-height: 820px !important;
    overflow-y: auto !important;
    scroll-behavior: smooth;
    border-radius: 0 !important;
  }

  /* Custom smooth scrollbar for inside device screen */
  .device-screen-window-mobile::-webkit-scrollbar,
  .device-screen-window-tablet::-webkit-scrollbar {
    width: 5px;
  }
  .device-screen-window-mobile::-webkit-scrollbar-thumb,
  .device-screen-window-tablet::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.4);
    border-radius: 10px;
  }

  /* Responsive viewport preview frames */
  #visual-canvas-wrapper {
    container-type: inline-size;
    container-name: canvas;
  }

  /* Scoped mobile preview behaviors when desktop admin simulates mobile frame */
  .preview-mobile-frame [class*="lg:grid-cols-12"],
  .preview-mobile-frame [class*="md:grid-cols-"],
  .preview-mobile-frame [class*="lg:grid-cols-"],
  .preview-mobile-frame [class*="sm:grid-cols-"] {
    grid-template-columns: repeat(1, minmax(0, 1fr)) !important;
  }

  .preview-mobile-frame [class*="lg:col-span-"] {
    grid-column: span 1 / span 1 !important;
  }

  .preview-mobile-frame [class*="lg:flex-row"],
  .preview-mobile-frame [class*="md:flex-row"],
  .preview-mobile-frame [class*="sm:flex-row"] {
    flex-direction: column !important;
  }

  .preview-mobile-frame .direct-button-editable {
    width: 100% !important;
    justify-content: center !important;
  }

  .preview-mobile-frame #canvas-hero-img,
  .preview-mobile-frame #canvas-why-us-img {
    height: 280px !important;
  }

  /* Scoped tablet preview behaviors when desktop admin simulates tablet frame */
  .preview-tablet-frame [class*="lg:grid-cols-12"] {
    grid-template-columns: repeat(1, minmax(0, 1fr)) !important;
  }

  .preview-tablet-frame [class*="lg:col-span-"] {
    grid-column: span 1 / span 1 !important;
  }

  .preview-tablet-frame [class*="lg:flex-row"] {
    flex-direction: column !important;
  }
</style>

<!-- Client-side Visual Editor Script -->
<script is:inline define:vars={{ initialCmsData }}>
  (function () {
    const cmsState = JSON.parse(JSON.stringify(initialCmsData));
    let isDirty = false;
    let activeImageTarget = null;
    let activeButtonTarget = null;

    const canvasWrapper = document.getElementById('visual-canvas-wrapper');
    const saveStatusPill = document.getElementById('save-status-pill');
    const saveStatusLabel = document.getElementById('save-status-label');
    const btnGlobalSave = document.getElementById('btn-global-save');
    const btnSaveText = document.getElementById('btn-save-text');
    const toast = document.getElementById('toast');

    // Popovers & Modals
    const mediaModal = document.getElementById('media-modal');
    const mediaModalClose = document.getElementById('media-modal-close');
    const mediaSearchInput = document.getElementById('media-search-input');
    const mediaFileInput = document.getElementById('media-file-input');
    const mediaGridContainer = document.getElementById('media-grid-container');

    const btnPopover = document.getElementById('button-inline-popover');
    const btnPopoverClose = document.getElementById('popover-btn-close');
    const btnPopoverDone = document.getElementById('popover-btn-done');
    const btnPopoverText = document.getElementById('popover-input-text');
    const btnPopoverUrl = document.getElementById('popover-input-url');

    const imgPopover = document.getElementById('image-inline-popover');
    const imgPopoverClose = document.getElementById('popover-img-close');
    const imgPopoverDone = document.getElementById('popover-img-done');
    const imgPopoverPreview = document.getElementById('popover-img-preview');
    const imgPopoverAlt = document.getElementById('popover-input-img-alt');
    const btnChooseMedia = document.getElementById('popover-btn-choose-media');

    function showToast(msg, isError = false) {
      if (!toast) return;
      toast.textContent = msg;
      toast.className = `fixed bottom-24 right-24 z-50 px-20 py-12 rounded-md shadow-2xl text-small font-semibold text-white transition-all transform duration-300 ${
        isError ? 'bg-feedback-error' : 'bg-brand-primary border border-brand-accent'
      }`;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 4000);
    }

    function setDirty(dirty) {
      isDirty = dirty;
      if (dirty) {
        saveStatusPill.className = 'h-36 px-12 rounded-md bg-amber-50 border border-amber-200 text-caption font-semibold text-amber-800 inline-flex items-center gap-6 transition-all whitespace-nowrap shrink-0 select-none';
        saveStatusPill.querySelector('span').className = 'w-6 h-6 rounded-full bg-amber-500 shrink-0';
        saveStatusLabel.textContent = 'Unsaved changes';
      } else {
        saveStatusPill.className = 'h-36 px-12 rounded-md bg-emerald-50 border border-emerald-200 text-caption font-semibold text-emerald-800 inline-flex items-center gap-6 transition-all whitespace-nowrap shrink-0 select-none';
        saveStatusPill.querySelector('span').className = 'w-6 h-6 rounded-full bg-emerald-500 shrink-0';
        saveStatusLabel.textContent = 'All changes saved';
      }
    }

    window.addEventListener('beforeunload', (e) => {
      if (isDirty) {
        e.preventDefault();
        e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
        return e.returnValue;
      }
    });

    // Viewport Mode Switcher & Device Mockup Frame Controls
    const btnDesktop = document.getElementById('btn-view-desktop');
    const btnTablet = document.getElementById('btn-view-tablet');
    const btnMobile = document.getElementById('btn-view-mobile');

    const deviceMockupFrame = document.getElementById('device-mockup-frame');
    const deviceScreenShell = document.getElementById('device-screen-shell');
    const deviceSpecBadge = document.getElementById('device-spec-badge');
    const deviceSpecIcon = document.getElementById('device-spec-icon');
    const deviceSpecLabel = document.getElementById('device-spec-label');
    const btnToggleDeviceHeight = document.getElementById('btn-toggle-device-height');
    const labelToggleDeviceHeight = document.getElementById('label-toggle-device-height');
    const deviceTopBar = document.getElementById('device-mockup-top-bar');
    const deviceTopMobile = document.getElementById('device-top-mobile-content');
    const deviceTopTablet = document.getElementById('device-top-tablet-content');
    const deviceBottomBar = document.getElementById('device-mockup-bottom-bar');
    const deviceHomeIndicator = document.getElementById('device-home-indicator');

    let currentMode = 'desktop';
    let isFitDeviceScreen = true;

    function applyScreenHeightMode() {
      if (!canvasWrapper) return;
      canvasWrapper.classList.remove('device-screen-window-mobile', 'device-screen-window-tablet');
      if (isFitDeviceScreen) {
        if (currentMode === 'mobile') {
          canvasWrapper.classList.add('device-screen-window-mobile');
        } else if (currentMode === 'tablet') {
          canvasWrapper.classList.add('device-screen-window-tablet');
        }
        if (labelToggleDeviceHeight) labelToggleDeviceHeight.textContent = 'Fit Device Window';
      } else {
        if (labelToggleDeviceHeight) labelToggleDeviceHeight.textContent = 'Full Length View';
      }
    }

    btnToggleDeviceHeight?.addEventListener('click', () => {
      isFitDeviceScreen = !isFitDeviceScreen;
      applyScreenHeightMode();
    });

    const iconSvgTablet = `<svg width="14" height="14" class="w-14 h-14 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>`;
    const iconSvgMobile = `<svg width="14" height="14" class="w-14 h-14 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>`;

    function setViewportMode(mode) {
      currentMode = mode;
      [btnDesktop, btnTablet, btnMobile].forEach(b => {
        b.className = 'h-32 px-12 rounded-md text-caption font-semibold text-text-secondary hover:text-brand-primary hover:bg-neutral-surface flex items-center gap-6 transition-all whitespace-nowrap shrink-0';
      });

      canvasWrapper.classList.remove('preview-tablet-frame', 'preview-mobile-frame', 'device-screen-window-mobile', 'device-screen-window-tablet');
      deviceMockupFrame.classList.remove('mode-mobile-device', 'mode-tablet-device');

      if (mode === 'desktop') {
        btnDesktop.className = 'h-32 px-12 rounded-md text-caption font-semibold bg-brand-primary text-white shadow-sm flex items-center gap-6 transition-all whitespace-nowrap shrink-0';
        deviceSpecBadge?.classList.add('hidden');
        deviceTopBar?.classList.add('hidden');
        deviceBottomBar?.classList.add('hidden');
        if (deviceScreenShell) deviceScreenShell.className = 'w-full bg-transparent overflow-visible rounded-none';
        deviceMockupFrame.className = 'w-full transition-all duration-300 mx-auto';
        canvasWrapper.className = 'w-full bg-white rounded-xl shadow-lg border border-neutral-border overflow-hidden transition-all duration-300 mx-auto';
      } else if (mode === 'tablet') {
        btnTablet.className = 'h-32 px-12 rounded-md text-caption font-semibold bg-brand-primary text-white shadow-sm flex items-center gap-6 transition-all whitespace-nowrap shrink-0';
        if (deviceSpecBadge) {
          deviceSpecBadge.classList.remove('hidden');
          deviceSpecBadge.className = 'flex mb-16 items-center gap-12 px-14 py-6 rounded-full bg-slate-900 text-white text-caption font-semibold shadow-lg border border-slate-700 animate-fade-in';
        }
        if (deviceSpecIcon) deviceSpecIcon.innerHTML = iconSvgTablet;
        if (deviceSpecLabel) deviceSpecLabel.textContent = 'Tablet Template — iPad (768px)';
        deviceTopBar?.classList.remove('hidden');
        deviceTopMobile?.classList.add('hidden');
        deviceTopTablet?.classList.remove('hidden');
        deviceBottomBar?.classList.remove('hidden');
        if (deviceHomeIndicator) deviceHomeIndicator.className = 'w-44 h-[4px] bg-white/40 rounded-full';
        if (deviceScreenShell) deviceScreenShell.className = 'w-full bg-slate-950 flex flex-col transition-all overflow-hidden rounded-[28px]';
        deviceMockupFrame.className = 'w-full mode-tablet-device transition-all duration-300 mx-auto';
        canvasWrapper.className = 'w-full bg-white transition-all duration-300 mx-auto preview-tablet-frame';
        applyScreenHeightMode();
      } else if (mode === 'mobile') {
        btnMobile.className = 'h-32 px-12 rounded-md text-caption font-semibold bg-brand-primary text-white shadow-sm flex items-center gap-6 transition-all whitespace-nowrap shrink-0';
        if (deviceSpecBadge) {
          deviceSpecBadge.classList.remove('hidden');
          deviceSpecBadge.className = 'flex mb-16 items-center gap-12 px-14 py-6 rounded-full bg-slate-900 text-white text-caption font-semibold shadow-lg border border-slate-700 animate-fade-in';
        }
        if (deviceSpecIcon) deviceSpecIcon.innerHTML = iconSvgMobile;
        if (deviceSpecLabel) deviceSpecLabel.textContent = 'Mobile Template — iPhone 15 Pro (390px)';
        deviceTopBar?.classList.remove('hidden');
        deviceTopMobile?.classList.remove('hidden');
        deviceTopTablet?.classList.add('hidden');
        deviceBottomBar?.classList.remove('hidden');
        if (deviceHomeIndicator) deviceHomeIndicator.className = 'w-32 h-[4px] bg-white/40 rounded-full';
        if (deviceScreenShell) deviceScreenShell.className = 'w-full bg-slate-950 flex flex-col transition-all overflow-hidden rounded-[42px]';
        deviceMockupFrame.className = 'w-full mode-mobile-device transition-all duration-300 mx-auto';
        canvasWrapper.className = 'w-full bg-white transition-all duration-300 mx-auto preview-mobile-frame';
        applyScreenHeightMode();
      }
    }

    btnDesktop?.addEventListener('click', () => setViewportMode('desktop'));
    btnTablet?.addEventListener('click', () => setViewportMode('tablet'));
    btnMobile?.addEventListener('click', () => setViewportMode('mobile'));

    // Section Jump Dropdown
    const sectionSelect = document.getElementById('section-jump-select');
    sectionSelect?.addEventListener('change', (e) => {
      const targetId = e.target.value;
      if (!targetId) return;
      const targetSec = document.getElementById(targetId);
      if (targetSec) {
        targetSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // 1. DIRECT INLINE TEXT EDITING LISTENERS
    document.querySelectorAll('.direct-inline-editable').forEach(el => {
      el.addEventListener('input', () => {
        setDirty(true);
        const section = el.getAttribute('data-section');
        const field = el.getAttribute('data-field');
        const extraField = el.getAttribute('data-extra-field');
        const arrayIdx = el.getAttribute('data-array-index');
        const arrayField = el.getAttribute('data-array-field');
        const featIdx = el.getAttribute('data-feature-index');
        const featField = el.getAttribute('data-feature-field');
        const stepIdx = el.getAttribute('data-step-index');
        const stepField = el.getAttribute('data-step-field');

        const val = el.innerText.trim();

        if (section && field && cmsState[section]) {
          cmsState[section][field] = val;
        } else if (section && extraField && cmsState[section]) {
          if (!cmsState[section].extra) cmsState[section].extra = {};
          cmsState[section].extra[extraField] = val;
        } else if (section === 'trust_signals' && arrayIdx !== null && arrayField) {
          const idx = parseInt(arrayIdx, 10);
          if (cmsState.trust_signals.items?.[idx]) {
            cmsState.trust_signals.items[idx][arrayField] = val;
          }
        } else if (section === 'why_us' && featIdx !== null && featField) {
          const idx = parseInt(featIdx, 10);
          if (cmsState.why_us.extra?.features?.[idx]) {
            cmsState.why_us.extra.features[idx][featField] = val;
          }
        } else if (section === 'how_it_works' && stepIdx !== null && stepField) {
          const idx = parseInt(stepIdx, 10);
          if (cmsState.how_it_works.steps?.[idx]) {
            cmsState.how_it_works.steps[idx][stepField] = val;
          }
        }
      });
    });

    // 2. DIRECT IN-PLACE BUTTON EDITING
    document.querySelectorAll('.direct-button-editable').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        activeButtonTarget = btn;

        const section = btn.getAttribute('data-section');
        const labelField = btn.getAttribute('data-label-field');
        const urlField = btn.getAttribute('data-url-field');
        const currentText = (cmsState[section]?.[labelField] !== undefined) ? cmsState[section][labelField] : (btn.getAttribute('data-text') || '');
        const currentUrl = (cmsState[section]?.[urlField] !== undefined) ? cmsState[section][urlField] : (btn.getAttribute('data-url') || '');

        btnPopoverText.value = currentText;
        btnPopoverUrl.value = currentUrl;

        // Position popover directly above or below button
        const rect = btn.getBoundingClientRect();
        const popoverWidth = btnPopover.offsetWidth || 320;
        const leftPos = Math.max(16, Math.min(window.innerWidth - popoverWidth - 16, rect.left));
        btnPopover.style.top = Math.max(20, rect.bottom + 8) + 'px';
        btnPopover.style.left = leftPos + 'px';
        btnPopover.classList.remove('hidden');
        btnPopoverText.focus();
      });
    });

    function closeButtonPopover(applyChanges = true) {
      if (activeButtonTarget && applyChanges) {
        const section = activeButtonTarget.getAttribute('data-section');
        const labelField = activeButtonTarget.getAttribute('data-label-field');
        const urlField = activeButtonTarget.getAttribute('data-url-field');

        const newText = btnPopoverText.value.trim();
        const newUrl = btnPopoverUrl.value.trim();

        if (cmsState[section]) {
          cmsState[section][labelField] = newText;
          cmsState[section][urlField] = newUrl;
        }

        const displayText = activeButtonTarget.querySelector('.btn-display-text');
        if (displayText) displayText.textContent = newText;
        setDirty(true);
      }
      btnPopover.classList.add('hidden');
      activeButtonTarget = null;
    }

    btnPopoverClose?.addEventListener('click', () => {
      btnPopover.classList.add('hidden');
      activeButtonTarget = null;
    });
    btnPopoverDone?.addEventListener('click', () => closeButtonPopover(true));

    // Prevent clicks inside the popover from bubbling to document click-outside listener
    btnPopover?.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    btnPopoverText?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        closeButtonPopover(true);
      }
    });
    btnPopoverUrl?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        closeButtonPopover(true);
      }
    });

    // 3. DIRECT IN-PLACE IMAGE EDITING
    document.querySelectorAll('.direct-image-editable').forEach(imgWrapper => {
      imgWrapper.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        // If button popover is open, close it
        if (btnPopover && !btnPopover.classList.contains('hidden')) {
          closeButtonPopover(true);
        }
        activeImageTarget = imgWrapper;

        const section = imgWrapper.getAttribute('data-section');
        const currentUrl = cmsState[section]?.image_url || imgWrapper.getAttribute('data-img-url') || '';
        const currentAlt = cmsState[section]?.image_alt || imgWrapper.getAttribute('data-img-alt') || '';

        imgPopoverPreview.src = currentUrl;
        imgPopoverAlt.value = currentAlt;

        const rect = imgWrapper.getBoundingClientRect();
        const popoverWidth = imgPopover.offsetWidth || 320;
        const leftPos = Math.max(16, Math.min(window.innerWidth - popoverWidth - 16, rect.left + 20));
        imgPopover.style.top = Math.max(20, rect.top + 20) + 'px';
        imgPopover.style.left = leftPos + 'px';
        imgPopover.classList.remove('hidden');
      });
    });

    function closeImagePopover(applyChanges = true) {
      if (activeImageTarget && applyChanges) {
        const section = activeImageTarget.getAttribute('data-section');
        const newAlt = imgPopoverAlt.value.trim();
        if (cmsState[section]) {
          cmsState[section].image_alt = newAlt;
        }
        const img = activeImageTarget.querySelector('img');
        if (img) img.alt = newAlt;
        setDirty(true);
      }
      imgPopover.classList.add('hidden');
      activeImageTarget = null;
    }

    imgPopoverClose?.addEventListener('click', () => {
      imgPopover.classList.add('hidden');
      activeImageTarget = null;
    });
    imgPopoverDone?.addEventListener('click', () => closeImagePopover(true));

    // Prevent clicks inside image popover from bubbling
    imgPopover?.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    imgPopoverAlt?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        closeImagePopover(true);
      }
    });

    // Global Click-Outside Listener to close any open popovers when clicking on anything outside
    document.addEventListener('click', (e) => {
      if (btnPopover && !btnPopover.classList.contains('hidden')) {
        if (!btnPopover.contains(e.target) && !e.target.closest('.direct-button-editable')) {
          closeButtonPopover(true);
        }
      }

      if (imgPopover && !imgPopover.classList.contains('hidden')) {
        if (!imgPopover.contains(e.target) && !e.target.closest('.direct-image-editable') && !e.target.closest('#media-modal')) {
          closeImagePopover(true);
        }
      }
    });

    // Global Escape Key Listener to dismiss active popovers / modals
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (mediaModal && !mediaModal.classList.contains('hidden')) {
          mediaModal.classList.add('hidden');
          return;
        }
        if (btnPopover && !btnPopover.classList.contains('hidden')) {
          closeButtonPopover(false);
          return;
        }
        if (imgPopover && !imgPopover.classList.contains('hidden')) {
          closeImagePopover(false);
          return;
        }
      }
    });

    // Media Modal Integration
    btnChooseMedia?.addEventListener('click', () => {
      mediaModal.classList.remove('hidden');
    });

    mediaModalClose?.addEventListener('click', () => {
      mediaModal.classList.add('hidden');
    });

    mediaModal?.addEventListener('click', (e) => {
      if (e.target === mediaModal) mediaModal.classList.add('hidden');
    });

    mediaGridContainer?.addEventListener('click', (e) => {
      const card = e.target.closest('.media-item-card');
      if (!card || !activeImageTarget) return;

      const url = card.getAttribute('data-url');
      const alt = card.getAttribute('data-alt');

      const section = activeImageTarget.getAttribute('data-section');
      if (cmsState[section]) {
        cmsState[section].image_url = url;
        cmsState[section].image_alt = alt;
      }

      const img = activeImageTarget.querySelector('img');
      if (img) {
        img.src = url;
        img.alt = alt;
      }
      imgPopoverPreview.src = url;
      imgPopoverAlt.value = alt;

      setDirty(true);
      mediaModal.classList.add('hidden');
      showToast('Image updated directly on page!');
    });

    // Media Upload
    mediaFileInput?.addEventListener('change', async () => {
      const file = mediaFileInput.files?.[0];
      if (!file) return;

      const formData = new FormData();
      formData.append('file', file);
      formData.append('alt_text', file.name.replace(/\.[^/.]+$/, ''));

      try {
        showToast('Uploading image...');
        const res = await fetch('/api/admin/media', {
          method: 'POST',
          headers: {
            'X-CSRF-Token': window.__CSRF_TOKEN__ || ''
          },
          body: formData
        });
        const data = await res.json();
        if (data.success && data.media) {
          showToast('Image uploaded successfully!');
          if (activeImageTarget) {
            const url = data.media.url;
            const alt = data.media.alt_text || data.media.file_name;
            const section = activeImageTarget.getAttribute('data-section');
            if (cmsState[section]) {
              cmsState[section].image_url = url;
              cmsState[section].image_alt = alt;
            }
            const img = activeImageTarget.querySelector('img');
            if (img) {
              img.src = url;
              img.alt = alt;
            }
            imgPopoverPreview.src = url;
            imgPopoverAlt.value = alt;
            setDirty(true);
            mediaModal.classList.add('hidden');
          }
        } else {
          showToast(data.error || 'Upload failed', true);
        }
      } catch (err) {
        showToast('Upload error: ' + err.message, true);
      }
    });

    mediaSearchInput?.addEventListener('input', () => {
      const q = mediaSearchInput.value.toLowerCase().trim();
      const cards = mediaGridContainer.querySelectorAll('.media-item-card');
      cards.forEach(c => {
        const fn = (c.getAttribute('data-filename') || '').toLowerCase();
        const alt = (c.getAttribute('data-alt') || '').toLowerCase();
        if (!q || fn.includes(q) || alt.includes(q)) {
          c.classList.remove('hidden');
        } else {
          c.classList.add('hidden');
        }
      });
    });

    // 4. GLOBAL SAVE CHANGES
    async function saveAllChanges() {
      btnGlobalSave.disabled = true;
      if (btnSaveText) btnSaveText.textContent = 'Saving...';
      saveStatusLabel.textContent = 'Saving changes...';

      // Gather current innerText from DOM to ensure 100% fidelity
      const heroBadge = document.getElementById('canvas-hero-badge')?.innerText.trim() || cmsState.hero.badge;
      const heroTitle = document.getElementById('canvas-hero-title')?.innerText.trim() || cmsState.hero.title;
      const heroSubtitle = document.getElementById('canvas-hero-subtitle')?.innerText.trim() || cmsState.hero.subtitle;
      const servicesTitle = document.getElementById('canvas-services-title')?.innerText.trim() || cmsState.services_intro.title;
      const servicesSubtitle = document.getElementById('canvas-services-subtitle')?.innerText.trim() || cmsState.services_intro.subtitle;
      const emergencyTitle = document.getElementById('canvas-emergency-title')?.innerText.trim() || cmsState.emergency_cta.title;
      const whyUsTitle = document.getElementById('canvas-why-us-title')?.innerText.trim() || cmsState.why_us.title;
      const whyUsDesc = document.getElementById('canvas-why-us-desc')?.innerText.trim() || cmsState.why_us.description;
      const stepsTitle = document.getElementById('canvas-steps-title')?.innerText.trim() || cmsState.how_it_works.title;
      const areasTitle = document.getElementById('canvas-areas-title')?.innerText.trim() || cmsState.service_areas.title;
      const reviewsTitle = document.getElementById('canvas-reviews-title')?.innerText.trim() || cmsState.reviews_intro.title;
      const financingTitle = document.getElementById('canvas-financing-title')?.innerText.trim() || cmsState.financing_cta.title;
      const finalTitle = document.getElementById('canvas-final-title')?.innerText.trim() || cmsState.final_cta.title;

      const sectionsPayload = [
        {
          section_key: 'hero',
          title: heroTitle,
          subtitle: heroSubtitle,
          badge: heroBadge,
          primary_btn_text: cmsState.hero.primary_btn_text,
          primary_btn_url: cmsState.hero.primary_btn_url,
          secondary_btn_text: cmsState.hero.secondary_btn_text,
          secondary_btn_url: cmsState.hero.secondary_btn_url,
          image_url: cmsState.hero.image_url,
          image_alt: cmsState.hero.image_alt,
          is_enabled: cmsState.hero.is_enabled,
          extra_data: cmsState.hero.extra
        },
        {
          section_key: 'trust_signals',
          is_enabled: cmsState.trust_signals.is_enabled,
          extra_data: cmsState.trust_signals.items
        },
        {
          section_key: 'services_intro',
          title: servicesTitle,
          subtitle: servicesSubtitle,
          badge: cmsState.services_intro.badge,
          primary_btn_text: cmsState.services_intro.primary_btn_text,
          primary_btn_url: cmsState.services_intro.primary_btn_url,
          is_enabled: cmsState.services_intro.is_enabled
        },
        {
          section_key: 'emergency_cta',
          title: emergencyTitle,
          subtitle: cmsState.emergency_cta.subtitle,
          badge: cmsState.emergency_cta.badge,
          primary_btn_text: cmsState.emergency_cta.primary_btn_text,
          primary_btn_url: cmsState.emergency_cta.primary_btn_url,
          secondary_btn_text: cmsState.emergency_cta.secondary_btn_text,
          secondary_btn_url: cmsState.emergency_cta.secondary_btn_url,
          is_enabled: cmsState.emergency_cta.is_enabled
        },
        {
          section_key: 'why_us',
          title: whyUsTitle,
          description: whyUsDesc,
          badge: cmsState.why_us.badge,
          image_url: cmsState.why_us.image_url,
          image_alt: cmsState.why_us.image_alt,
          primary_btn_text: cmsState.why_us.primary_btn_text,
          primary_btn_url: cmsState.why_us.primary_btn_url,
          is_enabled: cmsState.why_us.is_enabled,
          extra_data: cmsState.why_us.extra
        },
        {
          section_key: 'how_it_works',
          title: stepsTitle,
          subtitle: cmsState.how_it_works.subtitle,
          badge: cmsState.how_it_works.badge,
          is_enabled: cmsState.how_it_works.is_enabled,
          extra_data: cmsState.how_it_works.steps
        },
        {
          section_key: 'service_areas',
          title: areasTitle,
          subtitle: cmsState.service_areas.subtitle,
          badge: cmsState.service_areas.badge,
          primary_btn_text: cmsState.service_areas.primary_btn_text,
          primary_btn_url: cmsState.service_areas.primary_btn_url,
          is_enabled: cmsState.service_areas.is_enabled,
          extra_data: cmsState.service_areas.areas
        },
        {
          section_key: 'reviews_intro',
          title: reviewsTitle,
          subtitle: cmsState.reviews_intro.subtitle,
          badge: cmsState.reviews_intro.badge,
          primary_btn_text: cmsState.reviews_intro.primary_btn_text,
          primary_btn_url: cmsState.reviews_intro.primary_btn_url,
          is_enabled: cmsState.reviews_intro.is_enabled
        },
        {
          section_key: 'financing_cta',
          title: financingTitle,
          subtitle: cmsState.financing_cta.subtitle,
          badge: cmsState.financing_cta.badge,
          primary_btn_text: cmsState.financing_cta.primary_btn_text,
          primary_btn_url: cmsState.financing_cta.primary_btn_url,
          is_enabled: cmsState.financing_cta.is_enabled
        },
        {
          section_key: 'final_cta',
          title: finalTitle,
          subtitle: cmsState.final_cta.subtitle,
          badge: cmsState.final_cta.badge,
          primary_btn_text: cmsState.final_cta.primary_btn_text,
          primary_btn_url: cmsState.final_cta.primary_btn_url,
          secondary_btn_text: cmsState.final_cta.secondary_btn_text,
          secondary_btn_url: cmsState.final_cta.secondary_btn_url,
          is_enabled: cmsState.final_cta.is_enabled
        }
      ];

      try {
        const res = await fetch('/api/admin/homepage', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': window.__CSRF_TOKEN__ || ''
          },
          body: JSON.stringify({ sections: sectionsPayload })
        });

        const data = await res.json();
        if (data.success) {
          setDirty(false);
          showToast('Saved! Changes broadcasted to public website in real time.');
        } else {
          showToast(data.error || 'Failed to save changes', true);
          setDirty(true);
        }
      } catch (err) {
        showToast('Network error: ' + err.message, true);
        setDirty(true);
      } finally {
        btnGlobalSave.disabled = false;
        if (btnSaveText) btnSaveText.textContent = 'Save Changes';
      }
    }

    btnGlobalSave?.addEventListener('click', saveAllChanges);
  })();
</script>
