---
import '../../styles/global.css';

const url = new URL(Astro.request.url);
const token = url.searchParams.get('token') || '';
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-neutral-background">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Set New Password | NorthStar HVAC Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
</head>
<body class="h-full flex items-center justify-center font-body antialiased text-text-primary bg-neutral-background p-16 sm:p-24 selection:bg-brand-accent selection:text-white">

  <div class="w-full max-w-[440px]">
    <!-- Brand Header -->
    <div class="text-center mb-32">
      <div class="inline-flex items-center justify-center w-48 h-48 rounded-md bg-brand-primary text-brand-accent shadow-md mb-12">
        <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
        </svg>
      </div>
      <h1 class="text-h2 font-heading font-extrabold text-brand-primary tracking-tight leading-tight">
        Create New Password
      </h1>
      <p class="text-small text-text-muted mt-4 font-medium">
        Choose a strong, unique operator password
      </p>
    </div>

    <!-- Reset Card -->
    <div class="bg-neutral-surface rounded-lg border border-neutral-border shadow-md p-32">
      <div id="notice-alert" class="hidden mb-16 p-12 rounded-md bg-emerald-50 border border-emerald-200 text-small text-emerald-800 font-medium leading-relaxed"></div>
      <div id="error-alert" class="hidden mb-16 p-12 rounded-md bg-red-50 border border-brand-emergency/30 text-small text-brand-emergency font-medium leading-relaxed"></div>

      <form id="reset-form" class="space-y-20">
        <input type="hidden" id="token" value={token} />

        <div>
          <label for="password" class="block text-caption font-heading font-bold uppercase tracking-wider text-text-secondary mb-8">
            New Password
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="8"
            placeholder="At least 8 characters"
            class="w-full h-48 px-16 text-body bg-neutral-surface border border-neutral-border rounded-md text-text-primary placeholder:text-text-muted/60 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-secondary/20 transition-all"
          />
        </div>

        <div>
          <label for="confirm-password" class="block text-caption font-heading font-bold uppercase tracking-wider text-text-secondary mb-8">
            Confirm New Password
          </label>
          <input
            type="password"
            id="confirm-password"
            name="confirm-password"
            required
            minlength="8"
            placeholder="Re-enter password"
            class="w-full h-48 px-16 text-body bg-neutral-surface border border-neutral-border rounded-md text-text-primary placeholder:text-text-muted/60 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-secondary/20 transition-all"
          />
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full h-48 px-24 bg-brand-accent hover:bg-brand-accent-hover text-white text-body font-body font-semibold rounded-md shadow-sm hover:shadow active:scale-[0.98] transition-all flex items-center justify-center gap-8 cursor-pointer mt-24"
        >
          <span id="btn-text">Save New Password</span>
        </button>
      </form>

      <div class="mt-24 pt-20 border-t border-neutral-border text-center">
        <a href="/admin/login" class="text-small font-semibold text-text-muted hover:text-brand-primary transition-colors">
          &larr; Back to sign in
        </a>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('reset-form') as HTMLFormElement;
    const errorAlert = document.getElementById('error-alert') as HTMLDivElement;
    const noticeAlert = document.getElementById('notice-alert') as HTMLDivElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text') as HTMLSpanElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorAlert.classList.add('hidden');
      noticeAlert.classList.add('hidden');

      const token = (document.getElementById('token') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value;

      if (!token) {
        errorAlert.textContent = 'Invalid or missing reset token from URL.';
        errorAlert.classList.remove('hidden');
        return;
      }

      if (password !== confirmPassword) {
        errorAlert.textContent = 'Passwords do not match.';
        errorAlert.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      btnText.textContent = 'Updating...';

      try {
        const res = await fetch('/api/admin/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, password })
        });

        const data = await res.json();

        if (!res.ok) {
          errorAlert.textContent = data.error || 'Failed to update password.';
          errorAlert.classList.remove('hidden');
        } else {
          noticeAlert.textContent = data.message;
          noticeAlert.classList.remove('hidden');
          form.classList.add('hidden');
          setTimeout(() => {
            window.location.href = '/admin/login';
          }, 2000);
        }
      } catch (err: any) {
        errorAlert.textContent = 'Error: ' + err.message;
        errorAlert.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Save New Password';
      }
    });
  </script>
</body>
</html>
