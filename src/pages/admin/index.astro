---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db, ensureDbInitialized } from '../../lib/db';

await ensureDbInitialized();

const user = Astro.locals.user;

// Fetch operational counts
const [servicesRes, reviewsRes, bookingsRes, mediaRes, auditRes] = await Promise.all([
  db.execute('SELECT COUNT(*) as total, SUM(CASE WHEN is_active = 1 THEN 1 ELSE 0 END) as active FROM services'),
  db.execute('SELECT COUNT(*) as total, SUM(CASE WHEN is_approved = 1 THEN 1 ELSE 0 END) as approved, SUM(CASE WHEN is_approved = 0 THEN 1 ELSE 0 END) as pending FROM reviews'),
  db.execute("SELECT COUNT(*) as total, SUM(CASE WHEN status = 'new' THEN 1 ELSE 0 END) as new_inquiries FROM booking_submissions"),
  db.execute('SELECT COUNT(*) as total FROM media'),
  db.execute('SELECT COUNT(*) as total FROM audit_logs')
]);

const servicesCount = Number(servicesRes.rows[0]?.active || 0);
const reviewsCount = Number(reviewsRes.rows[0]?.approved || 0);
const pendingReviews = Number(reviewsRes.rows[0]?.pending || 0);
const newInquiries = Number(bookingsRes.rows[0]?.new_inquiries || 0);
const mediaCount = Number(mediaRes.rows[0]?.total || 0);
const totalAuditEvents = Number(auditRes.rows[0]?.total || 0);
---

<AdminLayout title="Operations Overview" activeSection="dashboard">
  <!-- Page Header -->
  <div class="mb-32 flex flex-col md:flex-row md:items-center md:justify-between gap-16">
    <div>
      <h1 class="text-h2 font-heading font-extrabold text-brand-primary tracking-tight">Operational Dashboard</h1>
      <p class="text-small text-text-muted mt-4">Welcome back, <span class="font-semibold text-text-primary">{user?.name}</span>. Real-time control and system status.</p>
    </div>

    <div class="flex items-center gap-12">
      <a
        href="/admin/homepage"
        class="inline-flex items-center gap-8 h-40 px-16 bg-brand-accent hover:bg-brand-accent-hover text-white text-small font-semibold rounded-md shadow-sm hover:shadow transition-all"
      >
        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        Manage Homepage CMS
      </a>
      <a
        href="/admin/reviews"
        class="inline-flex items-center gap-8 h-40 px-16 bg-neutral-surface hover:bg-neutral-surface-alt border border-neutral-border text-brand-primary text-small font-semibold rounded-md transition-all"
      >
        <svg class="w-16 h-16 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Moderate Reviews {pendingReviews > 0 && <span class="bg-brand-accent text-white px-8 py-2 rounded-full text-caption font-bold ml-4">{pendingReviews}</span>}
      </a>
    </div>
  </div>

  <!-- Operational KPI Metric Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-20 mb-32">
    <!-- Active Services -->
    <div class="bg-neutral-surface rounded-lg border border-neutral-border p-24 shadow-sm hover:shadow transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-caption font-heading font-bold uppercase tracking-wider text-text-muted">Active Services</span>
        <div class="w-40 h-40 rounded-md bg-blue-50 text-brand-secondary flex items-center justify-center">
          <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
        </div>
      </div>
      <div class="mt-12">
        <div class="text-h1 font-heading font-extrabold text-brand-primary leading-none">{servicesCount}</div>
        <p class="text-caption text-text-muted mt-6 font-medium">Published live on main site</p>
      </div>
    </div>

    <!-- Approved Reviews -->
    <div class="bg-neutral-surface rounded-lg border border-neutral-border p-24 shadow-sm hover:shadow transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-caption font-heading font-bold uppercase tracking-wider text-text-muted">Customer Reviews</span>
        <div class="w-40 h-40 rounded-md bg-amber-50 text-amber-600 flex items-center justify-center">
          <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
          </svg>
        </div>
      </div>
      <div class="mt-12">
        <div class="text-h1 font-heading font-extrabold text-brand-primary leading-none">{reviewsCount}</div>
        <p class="text-caption text-text-muted mt-6 font-medium">{pendingReviews} pending moderation</p>
      </div>
    </div>

    <!-- Booking Requests -->
    <div class="bg-neutral-surface rounded-lg border border-neutral-border p-24 shadow-sm hover:shadow transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-caption font-heading font-bold uppercase tracking-wider text-text-muted">New Inquiries</span>
        <div class="w-40 h-40 rounded-md bg-orange-50 text-brand-accent flex items-center justify-center">
          <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
      </div>
      <div class="mt-12">
        <div class="text-h1 font-heading font-extrabold text-brand-primary leading-none">{newInquiries}</div>
        <p class="text-caption text-text-muted mt-6 font-medium">Awaiting staff response</p>
      </div>
    </div>

    <!-- Media Assets -->
    <div class="bg-neutral-surface rounded-lg border border-neutral-border p-24 shadow-sm hover:shadow transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-caption font-heading font-bold uppercase tracking-wider text-text-muted">Media Assets</span>
        <div class="w-40 h-40 rounded-md bg-purple-50 text-purple-600 flex items-center justify-center">
          <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      </div>
      <div class="mt-12">
        <div class="text-h1 font-heading font-extrabold text-brand-primary leading-none">{mediaCount}</div>
        <p class="text-caption text-text-muted mt-6 font-medium">Images in Media Library</p>
      </div>
    </div>

    <!-- Security & Audit -->
    <div class="bg-neutral-surface rounded-lg border border-neutral-border p-24 shadow-sm hover:shadow transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-caption font-heading font-bold uppercase tracking-wider text-text-muted">Audit Events</span>
        <div class="w-40 h-40 rounded-md bg-emerald-50 text-emerald-600 flex items-center justify-center">
          <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
      </div>
      <div class="mt-12">
        <div class="text-h1 font-heading font-extrabold text-brand-primary leading-none">{totalAuditEvents}</div>
        <p class="text-caption text-text-muted mt-6 font-medium">Audit logs recorded</p>
      </div>
    </div>
  </div>

  <!-- Operational Overview Quick Actions / Section Previews -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-24">
    <div class="lg:col-span-2 bg-neutral-surface rounded-lg border border-neutral-border p-24 sm:p-32 shadow-sm">
      <h2 class="text-body-large font-heading font-bold text-brand-primary mb-20">Content Management &amp; Quick Links</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-16">
        <a href="/admin/homepage" class="p-16 rounded-md border border-neutral-border hover:border-brand-accent hover:shadow-sm transition-all group">
          <div class="font-heading font-bold text-small text-brand-primary group-hover:text-brand-accent transition-colors flex items-center justify-between">
            Homepage CMS
            <span class="text-caption text-text-muted group-hover:translate-x-2 transition-transform">&rarr;</span>
          </div>
          <p class="text-caption text-text-muted mt-6">Edit headlines, buttons, images, and section visibility across the public homepage.</p>
        </a>

        <a href="/admin/media" class="p-16 rounded-md border border-neutral-border hover:border-brand-accent hover:shadow-sm transition-all group">
          <div class="font-heading font-bold text-small text-brand-primary group-hover:text-brand-accent transition-colors flex items-center justify-between">
            Media Library
            <span class="text-caption text-text-muted group-hover:translate-x-2 transition-transform">&rarr;</span>
          </div>
          <p class="text-caption text-text-muted mt-6">Upload, preview, organize, and replace image assets used across the website.</p>
        </a>

        <a href="/admin/services" class="p-16 rounded-md border border-neutral-border hover:border-brand-accent hover:shadow-sm transition-all group">
          <div class="font-heading font-bold text-small text-brand-primary group-hover:text-brand-accent transition-colors flex items-center justify-between">
            Services &amp; Pricing
            <span class="text-caption text-text-muted group-hover:translate-x-2 transition-transform">&rarr;</span>
          </div>
          <p class="text-caption text-text-muted mt-6">Create and modify HVAC service descriptions, pricing, guarantees, and detail pages.</p>
        </a>

        <a href="/admin/reviews" class="p-16 rounded-md border border-neutral-border hover:border-brand-accent hover:shadow-sm transition-all group">
          <div class="font-heading font-bold text-small text-brand-primary group-hover:text-brand-accent transition-colors flex items-center justify-between">
            Customer Reviews
            <span class="text-caption text-text-muted group-hover:translate-x-2 transition-transform">&rarr;</span>
          </div>
          <p class="text-caption text-text-muted mt-6">Approve, feature, edit, or remove customer testimonials shown on the website.</p>
        </a>

        <a href="/admin/bookings" class="p-16 rounded-md border border-neutral-border hover:border-brand-accent hover:shadow-sm transition-all group">
          <div class="font-heading font-bold text-small text-brand-primary group-hover:text-brand-accent transition-colors flex items-center justify-between">
            Booking Inquiries
            <span class="text-caption text-text-muted group-hover:translate-x-2 transition-transform">&rarr;</span>
          </div>
          <p class="text-caption text-text-muted mt-6">Manage customer appointment requests and update technician dispatch statuses.</p>
        </a>

        {user?.role === 'owner' && (
          <a href="/admin/navigation" class="p-16 rounded-md border border-neutral-border hover:border-brand-accent hover:shadow-sm transition-all group">
            <div class="font-heading font-bold text-small text-brand-primary group-hover:text-brand-accent transition-colors flex items-center justify-between">
              Navigation Links
              <span class="text-caption text-text-muted group-hover:translate-x-2 transition-transform">&rarr;</span>
            </div>
            <p class="text-caption text-text-muted mt-6">Configure header navigation menus, ordering, and the primary call-to-action button.</p>
          </a>
        )}
      </div>
    </div>

    <!-- Security & Role Badge Card -->
    <div class="bg-neutral-surface rounded-lg border border-neutral-border p-24 sm:p-32 shadow-sm flex flex-col justify-between">
      <div>
        <h2 class="text-body-large font-heading font-bold text-brand-primary mb-16">Operator Context</h2>
        <div class="space-y-16 text-small">
          <div>
            <span class="text-caption font-heading font-bold uppercase tracking-wider text-text-muted block">Signed In As</span>
            <span class="font-semibold text-text-primary text-small block mt-2">{user?.name} ({user?.email})</span>
          </div>
          <div>
            <span class="text-caption font-heading font-bold uppercase tracking-wider text-text-muted block">Current Access Role</span>
            <span class="inline-block mt-4 px-10 py-4 rounded-full font-bold uppercase tracking-wider text-[11px] bg-amber-100 text-amber-800 border border-amber-200">
              {user?.role}
            </span>
          </div>
          <div>
            <span class="text-caption font-heading font-bold uppercase tracking-wider text-text-muted block">Session Security</span>
            <span class="text-feedback-success font-medium text-small block mt-2">HttpOnly Cookie &bull; OWASP Compliant</span>
          </div>
        </div>
      </div>

      <div class="mt-24 pt-16 border-t border-neutral-border">
        <a href="/" target="_blank" class="w-full inline-flex items-center justify-center gap-8 py-10 px-16 bg-neutral-surface-alt hover:bg-slate-200 text-brand-primary text-caption font-bold rounded-md transition-colors">
          <span>Open Public Website &nearr;</span>
        </a>
      </div>
    </div>
  </div>
</AdminLayout>
