---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-neutral-background">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password | NorthStar HVAC Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
</head>
<body class="h-full flex items-center justify-center font-body antialiased text-text-primary bg-neutral-background p-16 sm:p-24 selection:bg-brand-accent selection:text-white">

  <div class="w-full max-w-[440px]">
    <!-- Brand Header -->
    <div class="text-center mb-32">
      <div class="inline-flex items-center justify-center w-48 h-48 rounded-md bg-brand-primary text-brand-accent shadow-md mb-12">
        <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
        </svg>
      </div>
      <h1 class="text-h2 font-heading font-extrabold text-brand-primary tracking-tight leading-tight">
        Password Recovery
      </h1>
      <p class="text-small text-text-muted mt-4 font-medium">
        Generate a secure, single-use recovery token
      </p>
    </div>

    <!-- Recovery Card -->
    <div class="bg-neutral-surface rounded-lg border border-neutral-border shadow-md p-32">
      <div id="notice-alert" class="hidden mb-16 p-12 rounded-md bg-emerald-50 border border-emerald-200 text-small text-emerald-800 font-medium leading-relaxed"></div>
      <div id="error-alert" class="hidden mb-16 p-12 rounded-md bg-red-50 border border-brand-emergency/30 text-small text-brand-emergency font-medium leading-relaxed"></div>

      <form id="forgot-form" class="space-y-20">
        <div>
          <label for="email" class="block text-caption font-heading font-bold uppercase tracking-wider text-text-secondary mb-8">
            Registered Admin Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="admin@northstarhvac.com"
            class="w-full h-48 px-16 text-body bg-neutral-surface border border-neutral-border rounded-md text-text-primary placeholder:text-text-muted/60 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-secondary/20 transition-all"
          />
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full h-48 px-24 bg-brand-accent hover:bg-brand-accent-hover text-white text-body font-body font-semibold rounded-md shadow-sm hover:shadow active:scale-[0.98] transition-all flex items-center justify-center gap-8 cursor-pointer mt-24"
        >
          <span id="btn-text">Send Recovery Instructions</span>
          <svg id="btn-spinner" class="hidden animate-spin h-16 w-16 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
        </button>
      </form>

      <div id="dev-link-container" class="hidden mt-20 p-16 bg-amber-50 border border-amber-200 rounded-md text-small text-amber-900">
        <p class="font-bold mb-4">Local Dev Mode Link:</p>
        <a id="dev-link" href="#" class="text-brand-accent hover:underline break-all font-mono text-caption"></a>
      </div>

      <div class="mt-24 pt-20 border-t border-neutral-border text-center">
        <a href="/admin/login" class="text-small font-semibold text-text-muted hover:text-brand-primary transition-colors">
          &larr; Back to sign in
        </a>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('forgot-form') as HTMLFormElement;
    const errorAlert = document.getElementById('error-alert') as HTMLDivElement;
    const noticeAlert = document.getElementById('notice-alert') as HTMLDivElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text') as HTMLSpanElement;
    const btnSpinner = document.getElementById('btn-spinner') as HTMLElement;
    const devLinkContainer = document.getElementById('dev-link-container') as HTMLDivElement;
    const devLink = document.getElementById('dev-link') as HTMLAnchorElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorAlert.classList.add('hidden');
      noticeAlert.classList.add('hidden');
      devLinkContainer.classList.add('hidden');

      const email = (document.getElementById('email') as HTMLInputElement).value;

      submitBtn.disabled = true;
      btnText.textContent = 'Processing...';
      btnSpinner.classList.remove('hidden');

      try {
        const res = await fetch('/api/admin/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });

        const data = await res.json();

        if (!res.ok) {
          errorAlert.textContent = data.error || 'Failed to process request.';
          errorAlert.classList.remove('hidden');
        } else {
          noticeAlert.textContent = data.message;
          noticeAlert.classList.remove('hidden');

          if (data.devResetLink) {
            devLink.href = data.devResetLink;
            devLink.textContent = window.location.origin + data.devResetLink;
            devLinkContainer.classList.remove('hidden');
          }
        }
      } catch (err: any) {
        errorAlert.textContent = 'Error: ' + err.message;
        errorAlert.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Send Recovery Instructions';
        btnSpinner.classList.add('hidden');
      }
    });
  </script>
</body>
</html>
