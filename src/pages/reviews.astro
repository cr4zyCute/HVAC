---
import Layout from '@/layouts/Layout.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import CTABanner from '@/components/sections/CTABanner.astro';
import reviews from '@/content/reviews.json';
---

<Layout 
  title="Customer Reviews & Testimonials — NorthStar HVAC" 
  description="Read 180+ verified 5-star reviews from local homeowners. Real feedback on emergency repairs, furnace maintenance, and transparent flat-rate pricing."
>
  <!-- Hero Section -->
  <section class="bg-neutral-bg border-b border-neutral-border py-64 md:py-80">
    <div class="container">
      <div class="max-w-3xl space-y-16">
        <Badge variant="info">VERIFIED HOMEOWNER FEEDBACK</Badge>
        <h1 class="text-h1 font-heading font-extrabold text-brand-primary leading-tight">
          Over 180+ Five-Star Reviews Across the Metro Area
        </h1>
        <p class="text-body text-text-secondary leading-relaxed">
          See what your neighbors have to say about our fast dispatch times, honest mechanical diagnostics, upfront flat-rate pricing, and respectful in-home service.
        </p>

        <div class="flex flex-wrap items-center gap-16 pt-8">
          <Button href="#write-review" variant="primary" size="lg">
            <Icon name="star" size={18} />
            Write a Review
          </Button>
          <Button href="/book" variant="outline" size="lg">
            Book Your Service
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Review Breakdown & Trust Scorecard -->
  <section class="py-64 bg-neutral-surface border-b border-neutral-border">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-32 items-center bg-neutral-bg p-32 md:p-48 rounded-xl border border-neutral-border shadow-sm">
        <!-- Big Rating Score -->
        <div class="lg:col-span-4 text-center lg:text-left space-y-8 border-b lg:border-b-0 lg:border-r border-neutral-border pb-24 lg:pb-0 lg:pr-32">
          <div class="text-[64px] font-heading font-extrabold text-brand-primary leading-none">4.9</div>
          <div class="flex items-center justify-center lg:justify-start gap-4 text-amber-500">
            <Icon name="star" size={24} />
            <Icon name="star" size={24} />
            <Icon name="star" size={24} />
            <Icon name="star" size={24} />
            <Icon name="star" size={24} />
          </div>
          <p class="text-small font-semibold text-text-secondary">Based on 184 Verified Homeowner Reviews</p>
          <div class="flex items-center justify-center lg:justify-start gap-12 pt-8">
            <span class="text-caption font-bold text-emerald-700 bg-emerald-50 px-8 py-4 rounded-sm border border-emerald-200">
              100% Recommended
            </span>
          </div>
        </div>

        <!-- Rating Distribution Bars -->
        <div class="lg:col-span-5 space-y-12">
          <div class="flex items-center gap-12 text-small">
            <span class="w-48 font-bold text-text-secondary">5 Star</span>
            <div class="flex-1 h-8 bg-neutral-border rounded-full overflow-hidden">
              <div class="w-[94%] h-full bg-amber-400"></div>
            </div>
            <span class="w-36 text-right font-medium text-text-muted">94%</span>
          </div>
          <div class="flex items-center gap-12 text-small">
            <span class="w-48 font-bold text-text-secondary">4 Star</span>
            <div class="flex-1 h-8 bg-neutral-border rounded-full overflow-hidden">
              <div class="w-[5%] h-full bg-amber-400"></div>
            </div>
            <span class="w-36 text-right font-medium text-text-muted">5%</span>
          </div>
          <div class="flex items-center gap-12 text-small">
            <span class="w-48 font-bold text-text-secondary">3 Star</span>
            <div class="flex-1 h-8 bg-neutral-border rounded-full overflow-hidden">
              <div class="w-[1%] h-full bg-amber-400"></div>
            </div>
            <span class="w-36 text-right font-medium text-text-muted">1%</span>
          </div>
          <div class="flex items-center gap-12 text-small">
            <span class="w-48 font-bold text-text-secondary">2 Star</span>
            <div class="flex-1 h-8 bg-neutral-border rounded-full overflow-hidden">
              <div class="w-[0%] h-full bg-neutral-border"></div>
            </div>
            <span class="w-36 text-right font-medium text-text-muted">0%</span>
          </div>
          <div class="flex items-center gap-12 text-small">
            <span class="w-48 font-bold text-text-secondary">1 Star</span>
            <div class="flex-1 h-8 bg-neutral-border rounded-full overflow-hidden">
              <div class="w-[0%] h-full bg-neutral-border"></div>
            </div>
            <span class="w-36 text-right font-medium text-text-muted">0%</span>
          </div>
        </div>

        <!-- Trust Badges Column -->
        <div class="lg:col-span-3 space-y-16 border-t lg:border-t-0 lg:border-l border-neutral-border pt-24 lg:pt-0 lg:pl-32 text-center lg:text-left">
          <div class="space-y-4">
            <span class="block text-small font-bold text-brand-primary">Google Verified</span>
            <span class="text-caption text-text-muted">4.9 ★★★★★ (140+ Reviews)</span>
          </div>
          <div class="space-y-4">
            <span class="block text-small font-bold text-brand-primary">Better Business Bureau</span>
            <span class="text-caption text-text-muted">A+ Accredited Member</span>
          </div>
          <div class="space-y-4">
            <span class="block text-small font-bold text-brand-primary">Angi Super Service Award</span>
            <span class="text-caption text-text-muted">Winner 2024 &amp; 2025</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews Grid -->
  <section class="py-80 bg-neutral-surface">
    <div class="container space-y-48">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-16 border-b border-neutral-border pb-24">
        <div>
          <span class="text-caption font-bold tracking-wider text-brand-accent uppercase">Real Experiences</span>
          <h2 class="text-h2 font-heading font-bold text-brand-primary mt-8">
            Recent Client Reviews
          </h2>
        </div>
        <p class="text-small text-text-muted">
          Showing verified residential &amp; light commercial service testimonials.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-32">
        {reviews.map((rev) => (
          <div class="bg-neutral-bg p-32 rounded-lg border border-neutral-border space-y-16 flex flex-col justify-between shadow-sm hover:border-brand-primary transition-colors">
            <div class="space-y-16">
              <!-- Rating & Badge -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-4 text-amber-500">
                  {Array.from({ length: rev.rating }).map(() => (
                    <Icon name="star" size={18} />
                  ))}
                </div>
                <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-8 py-2 rounded-sm border border-emerald-200">
                  Verified Customer
                </span>
              </div>

              <!-- Quote -->
              <p class="text-body text-text-secondary leading-relaxed italic">
                "{rev.quote}"
              </p>
            </div>

            <!-- Author & Metadata -->
            <div class="pt-16 border-t border-neutral-border space-y-4">
              <div class="font-heading font-bold text-brand-primary text-body">
                {rev.author}
              </div>
              <div class="flex items-center justify-between text-caption text-text-muted">
                <span>{rev.location}</span>
                <span class="text-brand-accent font-semibold">{rev.service}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Write a Review Section -->
  <section id="write-review" class="py-80 bg-neutral-bg border-t border-neutral-border">
    <div class="container max-w-3xl space-y-40">
      <div class="text-center space-y-12">
        <Badge variant="neutral">SHARE YOUR EXPERIENCE</Badge>
        <h2 class="text-h2 font-heading font-bold text-brand-primary">
          Write a Review for NorthStar HVAC
        </h2>
        <p class="text-body text-text-secondary">
          Did our technicians recently service your home? Share your feedback to help your neighbors choose with confidence.
        </p>
      </div>

      <form id="review-form" class="bg-neutral-surface p-32 md:p-48 rounded-xl border border-neutral-border shadow-sm space-y-24">
        <!-- Star Rating Picker -->
        <div class="space-y-8">
          <label class="block text-small font-heading font-bold text-brand-primary">
            Overall Rating:
          </label>
          <div class="flex items-center gap-8 text-neutral-border cursor-pointer" id="star-picker">
            {[1, 2, 3, 4, 5].map((star) => (
              <button 
                type="button" 
                data-star={star} 
                class="star-btn text-amber-400 hover:scale-110 transition-transform p-4"
                aria-label={`${star} Stars`}
              >
                <Icon name="star" size={28} />
              </button>
            ))}
            <span id="star-rating-label" class="text-small font-bold text-brand-primary ml-12">
              5 Stars (Exceptional Service)
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-20">
          <div>
            <label for="review-name" class="block text-small font-heading font-bold text-brand-primary mb-6">
              Your Name:
            </label>
            <input 
              type="text" 
              id="review-name" 
              required
              placeholder="e.g. Michael K." 
              class="w-full px-16 py-12 border border-neutral-border rounded-md text-small bg-neutral-bg focus:border-brand-primary focus:ring-1 focus:ring-brand-primary outline-none"
            />
          </div>

          <div>
            <label for="review-location" class="block text-small font-heading font-bold text-brand-primary mb-6">
              Neighborhood or City:
            </label>
            <input 
              type="text" 
              id="review-location" 
              required
              placeholder="e.g. Beaverton Hills" 
              class="w-full px-16 py-12 border border-neutral-border rounded-md text-small bg-neutral-bg focus:border-brand-primary focus:ring-1 focus:ring-brand-primary outline-none"
            />
          </div>
        </div>

        <div>
          <label for="review-service" class="block text-small font-heading font-bold text-brand-primary mb-6">
            Service Performed:
          </label>
          <select 
            id="review-service" 
            class="w-full px-16 py-12 border border-neutral-border rounded-md text-small bg-neutral-bg focus:border-brand-primary focus:ring-1 focus:ring-brand-primary outline-none"
          >
            <option value="Air Conditioning Repair">Air Conditioning Repair</option>
            <option value="Furnace & Heating Fix">Furnace &amp; Heating Fix</option>
            <option value="24-Point Annual Tune-Up">24-Point Annual Tune-Up</option>
            <option value="Emergency Heat Call">Emergency Heat Call</option>
            <option value="Heat Pump Installation">Heat Pump Installation</option>
          </select>
        </div>

        <div>
          <label for="review-text" class="block text-small font-heading font-bold text-brand-primary mb-6">
            Your Review Feedback:
          </label>
          <textarea 
            id="review-text" 
            rows="4" 
            required
            placeholder="Tell us about the technician, diagnostic clarity, punctuality, and overall experience..."
            class="w-full px-16 py-12 border border-neutral-border rounded-md text-small bg-neutral-bg focus:border-brand-primary focus:ring-1 focus:ring-brand-primary outline-none"
          ></textarea>
        </div>

        <div id="review-feedback-msg" class="hidden p-16 rounded-md text-small font-medium bg-emerald-50 text-emerald-900 border border-emerald-200">
          Thank you! Your verified review has been submitted for publication.
        </div>

        <button 
          type="submit" 
          class="w-full sm:w-auto px-32 py-14 bg-brand-primary text-white font-bold rounded-md hover:bg-brand-secondary transition-colors text-small flex items-center justify-center gap-8"
        >
          <Icon name="check" size={18} />
          <span>Submit Verified Review</span>
        </button>
      </form>
    </div>
  </section>

  <!-- CTA Banner -->
  <CTABanner
    title="Ready to Experience 5-Star Comfort in Your Home?"
    subtitle="Book your diagnostic appointment online today or call for 24/7 emergency dispatch."
    primaryCta={{ label: "Schedule Appointment", href: "/book" }}
    secondaryCta={{ label: "Call (555) 014-7824", href: "tel:5550147824" }}
    variant="primary"
  />

  <!-- Interactive Review Form Script -->
  <script is:inline>
    const starButtons = document.querySelectorAll('.star-btn');
    const label = document.getElementById('star-rating-label');
    const form = document.getElementById('review-form');
    const msg = document.getElementById('review-feedback-msg');

    const ratings = {
      1: "1 Star (Poor Experience)",
      2: "2 Stars (Below Expectations)",
      3: "3 Stars (Average Service)",
      4: "4 Stars (Good Service)",
      5: "5 Stars (Exceptional Service)"
    };

    starButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const rating = parseInt(btn.getAttribute('data-star') || '5');
        label.textContent = ratings[rating];
        starButtons.forEach(b => {
          const bRating = parseInt(b.getAttribute('data-star') || '0');
          if (bRating <= rating) {
            b.classList.add('text-amber-400');
            b.classList.remove('text-neutral-300');
          } else {
            b.classList.remove('text-amber-400');
            b.classList.add('text-neutral-300');
          }
        });
      });
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      msg.classList.remove('hidden');
      form.reset();
      setTimeout(() => {
        msg.scrollIntoView({ behavior: 'smooth' });
      }, 100);
    });
  </script>
</Layout>
