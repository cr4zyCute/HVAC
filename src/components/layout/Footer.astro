---
import Icon from '@/components/ui/Icon.astro';
import siteConfig from '@/data/siteConfig.json';
import { getSiteSettings } from '@/lib/db';

const dbSettings = await getSiteSettings().catch(() => ({} as Record<string, string>));

const company = {
  ...siteConfig.company,
  brandFirst: dbSettings['brand_first'] || siteConfig.company.brandFirst,
  brandAccent: dbSettings['brand_accent'] || siteConfig.company.brandAccent,
  description: dbSettings['description'] || siteConfig.company.description,
  phone: dbSettings['phone_primary'] || siteConfig.company.phone,
  phoneRaw: dbSettings['phone_raw'] || siteConfig.company.phoneRaw,
  email: dbSettings['email_primary'] || siteConfig.company.email,
  address: dbSettings['address'] || siteConfig.company.address,
  operatingHours: dbSettings['operating_hours'] || siteConfig.company.operatingHours,
  license: dbSettings['license_number'] || siteConfig.company.license,
  copyright: dbSettings['footer_copyright'] || 'NorthStar HVAC Services. All rights reserved.',
  facebook: dbSettings['social_facebook'] || 'https://facebook.com',
  instagram: dbSettings['social_instagram'] || 'https://instagram.com',
  linkedin: dbSettings['social_linkedin'] || 'https://linkedin.com',
  youtube: dbSettings['social_youtube'] || 'https://youtube.com',
};
---

<footer class="bg-brand-secondary text-white pt-80 pb-32 border-t border-brand-primary">
  <div class="container space-y-64">
    <!-- Main 4-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-48 lg:gap-32">
      <!-- Col 1: Brand Info -->
      <div class="space-y-20">
        <a href="/" class="flex items-center gap-12 group focus-visible:rounded-sm">
          <div class="w-40 h-40 rounded-md bg-brand-primary flex items-center justify-center text-white shadow-sm">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M12 2L13.5 9.5L21 11L13.5 12.5L12 20L10.5 12.5L3 11L10.5 9.5L12 2Z" fill="#FFFFFF"/>
              <circle cx="12" cy="11" r="2" fill="#E65100"/>
            </svg>
          </div>
          <div>
            <div class="font-heading font-extrabold text-h3 text-white tracking-tight">
              {company.brandFirst}<span class="text-brand-accent">{company.brandAccent}</span>
            </div>
          </div>
        </a>

        <p class="text-small text-text-muted leading-relaxed">
          {company.description}
        </p>

        <!-- Social / Trust Icons -->
        <div class="flex items-center gap-12 pt-8">
          {company.facebook && (
            <a href={company.facebook} target="_blank" rel="noopener noreferrer" class="w-36 h-36 rounded-full bg-brand-primary flex items-center justify-center text-text-muted hover:text-white transition-colors" aria-label="Facebook">
              <Icon name="shield" size={16} />
            </a>
          )}
          {company.instagram && (
            <a href={company.instagram} target="_blank" rel="noopener noreferrer" class="w-36 h-36 rounded-full bg-brand-primary flex items-center justify-center text-text-muted hover:text-white transition-colors" aria-label="Instagram">
              <Icon name="star" size={16} />
            </a>
          )}
          {company.linkedin && (
            <a href={company.linkedin} target="_blank" rel="noopener noreferrer" class="w-36 h-36 rounded-full bg-brand-primary flex items-center justify-center text-text-muted hover:text-white transition-colors" aria-label="LinkedIn">
              <Icon name="map-pin" size={16} />
            </a>
          )}
        </div>
      </div>

      <!-- Col 2: Company Links -->
      <div class="space-y-16">
        <h4 class="text-small font-heading font-bold uppercase tracking-wider text-white">Company</h4>
        <ul class="space-y-12 text-small text-text-muted">
          <li><a href="/services" class="hover:text-brand-accent transition-colors">Services Directory</a></li>
          <li><a href="/about" class="hover:text-brand-accent transition-colors">About {company.brandFirst}</a></li>
          <li><a href="/service-areas" class="hover:text-brand-accent transition-colors">Service Areas</a></li>
          <li><a href="/financing" class="hover:text-brand-accent transition-colors">Financing Plans</a></li>
          <li><a href="/reviews" class="hover:text-brand-accent transition-colors">Customer Reviews</a></li>
          <li><a href="/contact" class="hover:text-brand-accent transition-colors">Contact Us</a></li>
          <li><a href="/style-guide" class="hover:text-brand-accent transition-colors text-amber-400">Design Style Guide</a></li>
        </ul>
      </div>

      <!-- Col 3: Services Direct Links -->
      <div class="space-y-16">
        <h4 class="text-small font-heading font-bold uppercase tracking-wider text-white">Services</h4>
        <ul class="space-y-12 text-small text-text-muted">
          <li><a href="/services/air-conditioning-repair" class="hover:text-brand-accent transition-colors">Air Conditioning Repair</a></li>
          <li><a href="/services/heating-furnace-service" class="hover:text-brand-accent transition-colors">Furnace &amp; Heating Fix</a></li>
          <li><a href="/services/annual-maintenance-plan" class="hover:text-brand-accent transition-colors">Shield Maintenance Club</a></li>
          <li><a href="/emergency" class="hover:text-red-400 transition-colors font-semibold text-brand-emergency">24/7 Emergency Dispatch</a></li>
          <li><a href="/book" class="hover:text-brand-accent transition-colors">Online Booking Wizard</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact & Dispatch -->
      <div class="space-y-16">
        <h4 class="text-small font-heading font-bold uppercase tracking-wider text-white">Direct Contact</h4>
        <div class="space-y-12">
          <div>
            <div class="text-[11px] font-bold uppercase tracking-widest text-text-muted">24/7 Dispatch Hotline</div>
            <a href={`tel:${company.phoneRaw}`} class="text-h3 font-heading font-bold text-white hover:text-brand-accent transition-colors block mt-4">
              {company.phone}
            </a>
          </div>

          <div>
            <div class="text-[11px] font-bold uppercase tracking-widest text-text-muted">Support Email</div>
            <a href={`mailto:${company.email}`} class="text-small text-text-muted hover:text-white transition-colors block mt-2">
              {company.email}
            </a>
          </div>

          <div class="pt-4 flex items-center gap-8 text-small font-semibold text-feedback-success">
            <span class="w-8 h-8 rounded-full bg-feedback-success"></span>
            <span>{company.operatingHours}</span>
          </div>

          <div class="text-caption text-text-muted pt-4">
            {company.address}
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Legal Row -->
    <div class="pt-32 border-t border-brand-primary flex flex-col sm:flex-row items-center justify-between gap-16 text-caption text-text-muted">
      <div>
        &copy; {new Date().getFullYear()} {company.copyright} {company.license}
      </div>
      <div class="flex items-center gap-24">
        <a href="/admin" class="hover:text-brand-accent transition-colors">Admin Login</a>
        <a href="/privacy" class="hover:text-brand-accent transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-brand-accent transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
