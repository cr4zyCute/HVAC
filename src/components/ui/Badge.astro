---
interface Props {
  variant?: 'emergency' | 'success' | 'warning' | 'info' | 'neutral';
  size?: 'sm' | 'md';
  dot?: boolean;
  class?: string;
}

const {
  variant = 'neutral',
  size = 'md',
  dot = false,
  class: className = '',
} = Astro.props;

const baseStyles = 'inline-flex items-center gap-6 font-body font-bold uppercase tracking-wider rounded-full border select-none';

const sizeStyles = {
  sm: 'px-8 py-2 text-[10px]',
  md: 'px-12 py-4 text-caption',
};

const variantStyles = {
  emergency: 'bg-red-50 text-brand-emergency border-red-200',
  success: 'bg-emerald-50 text-feedback-success border-emerald-200',
  warning: 'bg-amber-50 text-feedback-warning border-amber-200',
  info: 'bg-sky-50 text-sky-700 border-sky-200',
  neutral: 'bg-neutral-surface-alt text-text-muted border-neutral-border',
};

const dotColors = {
  emergency: 'bg-brand-emergency',
  success: 'bg-feedback-success',
  warning: 'bg-feedback-warning',
  info: 'bg-sky-600',
  neutral: 'bg-text-muted',
};

const classes = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`.trim();
---

<span class={classes}>
  {dot && (
    <span class="relative flex h-8 w-8">
      <span class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${dotColors[variant]}`}></span>
      <span class={`relative inline-flex rounded-full h-8 w-8 ${dotColors[variant]}`}></span>
    </span>
  )}
  <slot />
</span>

