---
import '../styles/global.css';

interface Props {
  title: string;
  activeSection?: 'dashboard' | 'homepage' | 'reviews' | 'services' | 'bookings' | 'media' | 'navigation' | 'settings' | 'audit-logs';
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const { title, activeSection = 'dashboard', breadcrumbs = [] } = Astro.props;
const user = Astro.locals.user;
const isOwner = user?.role === 'owner';
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-neutral-background">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | NorthStar HVAC Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <meta name="csrf-token" content={user?.csrfToken || ''} />
  <script define:vars={{ csrfToken: user?.csrfToken || '' }}>
    window.__CSRF_TOKEN__ = csrfToken;
  </script>
</head>
<body class="min-h-full font-body antialiased text-text-primary bg-neutral-background flex flex-col md:flex-row overflow-x-hidden">

  <!-- Mobile Topbar (< md) -->
  <header class="md:hidden bg-brand-primary text-white px-16 py-12 flex items-center justify-between border-b border-brand-secondary z-30 sticky top-0">
    <div class="flex items-center gap-10">
      <div class="w-32 h-32 rounded-md bg-brand-secondary flex items-center justify-center text-brand-accent shadow-sm shrink-0">
        <svg class="w-16 h-16" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
        </svg>
      </div>
      <div>
        <span class="text-small font-bold font-heading text-white block leading-tight">NorthStar HVAC</span>
        <span class="text-[10px] text-slate-400 block leading-tight">Control Center</span>
      </div>
    </div>
    <button id="mobile-menu-toggle" class="p-8 rounded-md text-slate-300 hover:text-white hover:bg-brand-secondary transition-colors" aria-label="Toggle Navigation">
      <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </header>

  <!-- Sidebar Navigation (Fixed 260px Desktop Sidebar) -->
  <aside id="admin-sidebar" class="hidden md:flex flex-col w-[260px] bg-brand-primary text-slate-200 border-r border-brand-secondary shrink-0 min-h-screen sticky top-0 h-screen z-30 overflow-hidden">
    <!-- Brand / Logo Area -->
    <div class="h-64 flex items-center justify-between px-20 border-b border-brand-secondary shrink-0">
      <div class="flex items-center gap-12 min-w-0">
        <div class="w-36 h-36 rounded-md bg-brand-secondary flex items-center justify-center text-brand-accent shadow shrink-0">
          <svg class="w-20 h-20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
          </svg>
        </div>
        <div class="min-w-0">
          <a href="/admin" class="text-body font-bold font-heading text-white tracking-tight hover:text-slate-100 block leading-tight truncate">NorthStar HVAC</a>
          <span class="text-caption text-slate-400 block font-medium leading-tight truncate">CMS Control Center</span>
        </div>
      </div>
      <!-- Mobile Close Button (shown only when expanded full on mobile) -->
      <button id="mobile-sidebar-close" class="md:hidden text-slate-400 hover:text-white p-4">
        ✕
      </button>
    </div>

    <!-- Navigation Menu -->
    <nav class="flex-1 px-12 py-16 space-y-4 overflow-y-auto overflow-x-hidden">
      <div class="px-12 pb-6 text-caption font-bold uppercase tracking-wider text-slate-400">
        Operations Management
      </div>

      <!-- Overview / Dashboard -->
      <a
        href="/admin"
        class={`flex items-center gap-10 px-12 py-10 rounded-md text-small font-medium transition-all ${
          activeSection === 'dashboard'
            ? 'bg-brand-secondary text-white font-semibold shadow-sm'
            : 'text-slate-300 hover:bg-[#152e4d] hover:text-white'
        }`}
      >
        <svg class="w-20 h-20 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        <span>Overview</span>
      </a>

      <!-- Inquiries & Bookings -->
      <a
        href="/admin/bookings"
        class={`flex items-center justify-between px-12 py-10 rounded-md text-small font-medium transition-all ${
          activeSection === 'bookings'
            ? 'bg-brand-secondary text-white font-semibold shadow-sm'
            : 'text-slate-300 hover:bg-[#152e4d] hover:text-white'
        }`}
      >
        <div class="flex items-center gap-10">
          <svg class="w-20 h-20 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <span>Inquiries & Bookings</span>
        </div>
      </a>

      <!-- Reviews -->
      <a
        href="/admin/reviews"
        class={`flex items-center justify-between px-12 py-10 rounded-md text-small font-medium transition-all ${
          activeSection === 'reviews'
            ? 'bg-brand-secondary text-white font-semibold shadow-sm'
            : 'text-slate-300 hover:bg-[#152e4d] hover:text-white'
        }`}
      >
        <div class="flex items-center gap-10">
          <svg class="w-20 h-20 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
          </svg>
          <span>Customer Reviews</span>
        </div>
      </a>

      <!-- Content Management Section Divider -->
      <div class="pt-20 px-12 pb-6 text-caption font-bold uppercase tracking-wider text-slate-400">
        Website CMS Content
      </div>

      <!-- Homepage CMS -->
      <a
        href="/admin/homepage"
        class={`flex items-center gap-10 px-12 py-10 rounded-md text-small font-medium transition-all ${
          activeSection === 'homepage'
            ? 'bg-brand-secondary text-white font-semibold shadow-sm'
            : 'text-slate-300 hover:bg-[#152e4d] hover:text-white'
        }`}
      >
        <svg class="w-20 h-20 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
        </svg>
        <span>Homepage Content Management</span>
      </a>

      <!-- Services & Pricing -->
      <a
        href="/admin/services"
        class={`flex items-center gap-10 px-12 py-10 rounded-md text-small font-medium transition-all ${
          activeSection === 'services'
            ? 'bg-brand-secondary text-white font-semibold shadow-sm'
            : 'text-slate-300 hover:bg-[#152e4d] hover:text-white'
        }`}
      >
        <svg class="w-20 h-20 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
        </svg>
        <span>Services &amp; Pricing</span>
      </a>

      <!-- Media Library -->
      <a
        href="/admin/media"
        class={`flex items-center gap-10 px-12 py-10 rounded-md text-small font-medium transition-all ${
          activeSection === 'media'
            ? 'bg-brand-secondary text-white font-semibold shadow-sm'
            : 'text-slate-300 hover:bg-[#152e4d] hover:text-white'
        }`}
      >
        <svg class="w-20 h-20 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Media Library</span>
      </a>

      <!-- Navigation Links -->
      <a
        href="/admin/navigation"
        class={`flex items-center gap-10 px-12 py-10 rounded-md text-small font-medium transition-all ${
          activeSection === 'navigation'
            ? 'bg-brand-secondary text-white font-semibold shadow-sm'
            : 'text-slate-300 hover:bg-[#152e4d] hover:text-white'
        }`}
      >
        <svg class="w-20 h-20 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
        <span>Navigation Links</span>
      </a>

      <!-- Owner Section Divider -->
      <div class="pt-20 px-12 pb-6 text-caption font-bold uppercase tracking-wider text-slate-400">
        System &amp; Governance
      </div>

      <!-- Site Settings (Owner only) -->
      {isOwner ? (
        <a
          href="/admin/settings"
          class={`flex items-center gap-10 px-12 py-10 rounded-md text-small font-medium transition-all ${
            activeSection === 'settings'
              ? 'bg-brand-secondary text-white font-semibold shadow-sm'
              : 'text-slate-300 hover:bg-[#152e4d] hover:text-white'
          }`}
        >
          <svg class="w-20 h-20 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>Site Settings</span>
        </a>
      ) : (
        <div class="flex items-center gap-10 px-12 py-8 text-caption text-slate-500 cursor-not-allowed">
          <svg class="w-16 h-16 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          <span>Site Settings (Owner)</span>
        </div>
      )}

      <!-- Audit Logs (Owner only) -->
      {isOwner ? (
        <a
          href="/admin/audit-logs"
          class={`flex items-center gap-10 px-12 py-10 rounded-md text-small font-medium transition-all ${
            activeSection === 'audit-logs'
              ? 'bg-brand-secondary text-white font-semibold shadow-sm'
              : 'text-slate-300 hover:bg-[#152e4d] hover:text-white'
          }`}
        >
          <svg class="w-20 h-20 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <span>Security Audit Logs</span>
        </a>
      ) : null}
    </nav>

    <!-- Sidebar Footer / Public Site Link -->
    <div class="p-16 border-t border-brand-secondary shrink-0">
      <a
        href="/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between px-12 py-10 rounded-md bg-[#152e4d] hover:bg-brand-secondary text-caption font-semibold text-white transition-colors"
      >
        <span class="flex items-center gap-8">
          <svg class="w-16 h-16 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
          <span>View Live Website</span>
        </span>
        <span class="text-caption text-slate-400">&nearr;</span>
      </a>
    </div>
  </aside>

  <!-- Main Content Column -->
  <div class="flex-1 flex flex-col min-w-0 bg-neutral-background min-h-screen overflow-x-hidden">

    <!-- Top Navigation Bar -->
    <header class="h-64 bg-neutral-surface border-b border-neutral-border px-24 flex items-center justify-between sticky top-0 z-20 shrink-0">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-8 text-small font-medium text-text-muted">
        <a href="/admin" class="hover:text-brand-primary transition-colors">Admin</a>
        {breadcrumbs.map((crumb) => (
          <>
            <span class="text-neutral-border">/</span>
            {crumb.href ? (
              <a href={crumb.href} class="hover:text-brand-primary transition-colors">{crumb.label}</a>
            ) : (
              <span class="text-text-primary font-semibold">{crumb.label}</span>
            )}
          </>
        ))}
      </nav>

      <!-- Right Area: User identity, Role badge & Logout -->
      <div class="flex items-center gap-16">
        <div class="flex items-center gap-10">
          <div class="w-36 h-36 rounded-full bg-brand-primary text-white flex items-center justify-center font-bold text-caption shadow-sm shrink-0">
            {user?.name ? user.name.slice(0, 1).toUpperCase() : 'A'}
          </div>
          <div class="hidden sm:block text-left">
            <div class="text-small font-bold font-heading text-brand-primary leading-tight flex items-center gap-6">
              <span>{user?.name || 'Administrator'}</span>
              <span class={`text-[10px] font-bold px-8 py-2 rounded-full uppercase tracking-wider ${
                isOwner ? 'bg-amber-100 text-amber-800 border border-amber-200' : 'bg-slate-100 text-slate-700 border border-slate-200'
              }`}>
                {user?.role || 'staff'}
              </span>
            </div>
            <div class="text-caption text-text-muted leading-tight mt-2">{user?.email}</div>
          </div>
        </div>

        <button
          id="logout-btn"
          class="inline-flex items-center gap-6 h-36 px-12 border border-neutral-border rounded-md text-caption font-semibold text-text-secondary hover:text-brand-emergency hover:border-brand-emergency hover:bg-red-50 transition-all cursor-pointer"
          title="Sign out securely"
        >
          <svg class="w-16 h-16 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          <span class="hidden sm:inline">Sign Out</span>
        </button>
      </div>
    </header>

    <!-- Page Content Container -->
    <main class="flex-1 p-20 sm:p-28 lg:p-32 max-w-7xl w-full mx-auto">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="py-16 px-24 border-t border-neutral-border bg-neutral-surface text-caption text-text-muted flex flex-col sm:flex-row items-center justify-between gap-8 shrink-0">
      <div>NorthStar HVAC Operational Control Center &bull; Authenticated as <span class="font-mono text-text-secondary">{user?.email}</span></div>
      <div>Strict OWASP RBAC &bull; Session Secured</div>
    </footer>
  </div>

  <script>
    // Logout Handler
    const logoutBtn = document.getElementById('logout-btn');
    logoutBtn?.addEventListener('click', async () => {
      try {
        const res = await fetch('/api/admin/auth/logout', { method: 'POST' });
        if (res.ok) {
          window.location.href = '/admin/login';
        }
      } catch (e) {
        console.error('Logout failed:', e);
      }
    });

    // Mobile Sidebar Toggle
    const mobileToggle = document.getElementById('mobile-menu-toggle');
    const mobileClose = document.getElementById('mobile-sidebar-close');
    const sidebar = document.getElementById('admin-sidebar');

    function toggleMobileSidebar() {
      if (sidebar) {
        sidebar.classList.toggle('hidden');
        sidebar.classList.toggle('flex');
        sidebar.classList.toggle('fixed');
        sidebar.classList.toggle('inset-0');
        sidebar.classList.toggle('z-50');
      }
    }

    mobileToggle?.addEventListener('click', toggleMobileSidebar);
    mobileClose?.addEventListener('click', toggleMobileSidebar);
  </script>
</body>
</html>
